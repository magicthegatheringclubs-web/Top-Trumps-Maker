function attachCatDrag() {
  const container = document.getElementById('cat-tags');
  container.querySelectorAll('.cat-drag-item').forEach(tag => {
    // Desktop mouse drag-and-drop (native HTML5 DnD — not supported via touch on iOS)
    tag.addEventListener('dragstart', e => { dragCatIndex = +tag.dataset.index; tag.style.opacity = '0.4'; e.dataTransfer.effectAllowed = 'move'; });
    tag.addEventListener('dragend', () => { tag.style.opacity = ''; dragCatIndex = null; });
    tag.addEventListener('dragover', e => { e.preventDefault(); tag.style.borderColor = 'var(--accent)'; });
    tag.addEventListener('dragleave', () => tag.style.borderColor = '');
    tag.addEventListener('drop', e => {
      e.preventDefault(); tag.style.borderColor = '';
      const drop = +tag.dataset.index;
      if (dragCatIndex === null || dragCatIndex === drop) return;
      const moved = cats.splice(dragCatIndex, 1)[0];
      cats.splice(drop, 0, moved);
      dragCatIndex = null;
      snapshot();
      renderCats(); renderCardList();
    });

    // Touch-friendly reorder via Pointer Events (this is what makes it work on iOS —
    // the native HTML5 Drag and Drop API above only fires for mouse, never for touch, on iOS Safari)
    const handle = tag.querySelector('.drag-handle');
    if (!handle) return;
    handle.addEventListener('pointerdown', e => {
      if (e.pointerType === 'mouse') return; // mouse already has native DnD above
      e.preventDefault();
      let currentIndex = +tag.dataset.index;
      let activeTag = tag;
      activeTag.classList.add('cat-dragging');

      const onMove = ev => {
        ev.preventDefault();
        const items = [...container.querySelectorAll('.cat-drag-item')];
        const overItem = items.find(item => {
          const r = item.getBoundingClientRect();
          return ev.clientY >= r.top && ev.clientY <= r.bottom;
        });
        if (overItem) {
          const overIndex = +overItem.dataset.index;
          if (overIndex !== currentIndex) {
            const moved = cats.splice(currentIndex, 1)[0];
            cats.splice(overIndex, 0, moved);
            currentIndex = overIndex;
            renderCats();
            activeTag = container.querySelector(`.cat-drag-item[data-index="${currentIndex}"]`);
            if (activeTag) activeTag.classList.add('cat-dragging');
          }
        }
      };
      const onUp = () => {
        document.removeEventListener('pointermove', onMove);
        document.removeEventListener('pointerup', onUp);
        document.removeEventListener('pointercancel', onUp);
        const draggedTag = container.querySelector('.cat-dragging');
        if (draggedTag) draggedTag.classList.remove('cat-dragging');
        snapshot();
        renderCardList();
      };
      document.addEventListener('pointermove', onMove, { passive: false });
      document.addEventListener('pointerup', onUp);
      document.addEventListener('pointercancel', onUp);
    }, { passive: false });
  });
}


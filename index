function initCharts(r) {
  const isDark = document.body.classList.contains('dark-mode');
  const textColor = isDark ? '#9b978f' : '#6b6860';
  const gridColor = isDark ? 'rgba(255,255,255,0.07)' : 'rgba(0,0,0,0.07)';

  r.validCards.forEach((card, ci) => {
    const canvas = document.getElementById(`radar-${ci}`);
    if (!canvas) return;
    drawRadar(canvas, card, r, textColor, gridColor, ci);
  });
  renderH2H();
}

function drawRadar(canvas, card, r, textColor, gridColor, cardIdx) {
  const ctx = canvas.getContext('2d');
  const W = canvas.width, H = canvas.height;
  const cx = W/2, cy = H/2;
  const radius = Math.min(W,H)/2 - 30;
  const n = r.cats.length;
  if (n < 3) { ctx.fillStyle = textColor; ctx.font = '12px sans-serif'; ctx.textAlign='center'; ctx.fillText('Need 3+ stats', cx, cy); return; }

  ctx.clearRect(0,0,W,H);

  // Accent colour
  const isDark = document.body.classList.contains('dark-mode');
  const tierColour = (cs) => {
    if (!cs) return '#3b82f6';
    return cs.tier==='strong'?'#22c55e':cs.tier==='good'?'#3b82f6':cs.tier==='average'?'#f59e0b':'#ef4444';
  };
  const cs = r.cardScores[cardIdx];
  const fillColour = tierColour(cs);

  const angle = i => (i / n) * 2 * Math.PI - Math.PI/2;
  const px = (i, r2) => cx + r2 * Math.cos(angle(i));
  const py = (i, r2) => cy + r2 * Math.sin(angle(i));

  // Grid rings
  [0.25, 0.5, 0.75, 1].forEach(frac => {
    ctx.beginPath();
    for (let i=0; i<n; i++) {
      const x = px(i, radius*frac), y = py(i, radius*frac);
      i===0 ? ctx.moveTo(x,y) : ctx.lineTo(x,y);
    }
    ctx.closePath();
    ctx.strokeStyle = gridColor;
    ctx.lineWidth = 1;
    ctx.stroke();
  });

  // Spokes
  for (let i=0; i<n; i++) {
    ctx.beginPath(); ctx.moveTo(cx,cy); ctx.lineTo(px(i,radius), py(i,radius));
    ctx.strokeStyle = gridColor; ctx.lineWidth = 1; ctx.stroke();
  }

  // Data polygon
  const vals = r.cats.map((cat, i) => {
    const range = r.catStats[i]?.range || [0,100];
    const span = range[1]-range[0] || 1;
    const raw = card.stats[cat];
    if (raw===''||raw===undefined||raw==='na') return 0;
    return Math.min(1, Math.max(0, (+raw - range[0]) / span));
  });

  ctx.beginPath();
  vals.forEach((v, i) => {
    const x = px(i, radius*v), y = py(i, radius*v);
    i===0 ? ctx.moveTo(x,y) : ctx.lineTo(x,y);
  });
  ctx.closePath();
  ctx.fillStyle = fillColour + (isDark ? '44' : '2a');
  ctx.fill();
  ctx.strokeStyle = fillColour;
  ctx.lineWidth = 2;
  ctx.stroke();

  // Dots
  vals.forEach((v, i) => {
    ctx.beginPath();
    ctx.arc(px(i, radius*v), py(i, radius*v), 4, 0, 2*Math.PI);
    ctx.fillStyle = fillColour; ctx.fill();
  });

  // Labels
  ctx.fillStyle = textColor;
  ctx.font = `bold 9px -apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif`;
  ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
  r.cats.forEach((cat, i) => {
    const lx = px(i, radius + 18), ly = py(i, radius + 18);
    const shortLabel = cat.length > 8 ? cat.slice(0,7)+'…' : cat;
    ctx.fillText(shortLabel.toUpperCase(), lx, ly);
  });
}

function renderH2H() {
  if (!_analyzeReport) return;
  const r = _analyzeReport;
  const esc = s => String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
  const lSel = document.getElementById('h2h-left');
  const rSel = document.getElementById('h2h-right');
  const table = document.getElementById('h2h-table');
  if (!lSel||!rSel||!table) return;
  const li = +lSel.value, ri = +rSel.value;
  const lc = r.validCards[li], rc = r.validCards[ri];
  if (!lc||!rc) return;

  const isDark = document.body.classList.contains('dark-mode');
  const winCol   = isDark ? '#4ade80' : '#16a34a';
  const loseCol  = isDark ? '#f87171' : '#dc2626';
  const tieCol   = isDark ? '#94a3b8' : '#6b7280';
  const barColL  = '#3b82f6';
  const barColR  = '#f59e0b';

  let lWins=0, rWins=0, ties=0;
  const rows = r.cats.map(cat => {
    const range = catRanges[cat]||[0,100];
    const span = range[1]-range[0]||1;
    const lRaw = lc.stats[cat], rRaw = rc.stats[cat];
    const lVal = (lRaw!==''&&lRaw!==undefined&&lRaw!=='na') ? +lRaw : null;
    const rVal = (rRaw!==''&&rRaw!==undefined&&rRaw!=='na') ? +rRaw : null;
    if (lVal===null&&rVal===null) return '';
    const lPct = lVal!==null ? Math.round((lVal-range[0])/span*100) : 0;
    const rPct = rVal!==null ? Math.round((rVal-range[0])/span*100) : 0;
    let lHl='', rHl='';
    if (lVal!==null&&rVal!==null) {
      if (lVal>rVal) { lHl=`color:${winCol};`; rHl=`color:${loseCol};`; lWins++; }
      else if (rVal>lVal) { rHl=`color:${winCol};`; lHl=`color:${loseCol};`; rWins++; }
      else { lHl=rHl=`color:${tieCol};`; ties++; }
    }
    return `
      <div class="az-h2h-row">
        <div class="az-h2h-bar-l" style="justify-content:flex-end;">
          ${lVal!==null ? `<div style="width:${lPct}%;max-width:100%;height:22px;background:${barColL}22;border-radius:4px;display:flex;align-items:center;justify-content:flex-end;padding-right:8px;">
            <span class="az-h2h-val" style="${lHl}">${lVal}</span>
          </div>` : `<span style="font-size:11px;color:var(--text2)">N/A</span>`}
        </div>
        <div style="font-size:10px;font-weight:700;color:var(--text2);text-align:center;text-transform:uppercase;letter-spacing:.05em;align-self:center;">${esc(cat)}</div>
        <div class="az-h2h-bar-r">
          ${rVal!==null ? `<div style="width:${rPct}%;max-width:100%;height:22px;background:${barColR}22;border-radius:4px;display:flex;align-items:center;padding-left:8px;">
            <span class="az-h2h-val" style="${rHl}">${rVal}</span>
          </div>` : `<span style="font-size:11px;color:var(--text2)">N/A</span>`}
        </div>
      </div>`;
  }).join('');

  table.innerHTML = `
    <div class="az-h2h-row" style="border-bottom:2px solid var(--border);padding-bottom:10px;margin-bottom:2px;">
      <div class="az-h2h-header" style="color:${barColL};">${esc(lc.name)}<br><small style="font-weight:400;color:var(--text2);">${lWins} win${lWins!==1?'s':''}</small></div>
      <div></div><div></div>
      <div class="az-h2h-header" style="color:${barColR};">${esc(rc.name)}<br><small style="font-weight:400;color:var(--text2);">${rWins} win${rWins!==1?'s':''}</small></div>
    </div>
    ${rows}
    ${ties>0?`<div style="text-align:center;font-size:11px;color:var(--text2);padding-top:8px;">${ties} tie${ties!==1?'s':''}</div>`:''}`;
}

function buildReport(deckName, filteredCards) {
  const validCards = (filteredCards || cards).filter(c => c && c.name);
  if (validCards.length < 2) throw new Error('Need at least 2 cards in this group to analyze.');

  const N = validCards.length;

  // Per-category stats
  const catStats = cats.map(cat => {
    const range = catRanges[cat] || [0, 100];
    const vals = validCards
      .map((c, i) => ({ i, name: c.name, raw: c.stats[cat] }))
      .filter(v => v.raw !== '' && v.raw !== undefined && v.raw !== 'na')
      .map(v => ({ ...v, val: +v.raw }));

    if (!vals.length) return { cat, range, vals: [], missing: N, mean: null, median: null, spread: null, winner: null, loser: null, hasMissing: true };

    vals.sort((a, b) => b.val - a.val);
    const numVals = vals.map(v => v.val);
    const mean = numVals.reduce((a,b) => a+b, 0) / numVals.length;
    const sorted = [...numVals].sort((a,b) => a-b);
    const mid = Math.floor(sorted.length/2);
    const median = sorted.length%2 ? sorted[mid] : (sorted[mid-1]+sorted[mid])/2;
    const spread = sorted[sorted.length-1] - sorted[0];
    const spreadPct = (range[1]-range[0]) > 0 ? spread/(range[1]-range[0]) : 0;
    const missing = N - vals.length;

    return {
      cat, range, vals, mean, median, spread, spreadPct, missing,
      winner: vals[0],
      loser:  vals[vals.length-1],
      hasMissing: missing > 0,
      // Is this category "decisive"? spread > 30% of range is good for gameplay
      isDecisive: spreadPct >= 0.30,
      isDull:     spreadPct < 0.15,
    };
  });

  // Per-card overall score (average of their stats as % of range, excluding na/empty)
  const cardScores = validCards.map((card, ci) => {
    const scores = [];
    cats.forEach(cat => {
      const range = catRanges[cat] || [0,100];
      const span = range[1] - range[0];
      const raw = card.stats[cat];
      if (raw === '' || raw === undefined || raw === 'na' || span === 0) return;
      scores.push(( +raw - range[0] ) / span);
    });
    const overallPct = scores.length ? scores.reduce((a,b)=>a+b,0)/scores.length : null;
    const missingCount = cats.filter(cat => {
      const raw = card.stats[cat];
      return raw === '' || raw === undefined || raw === 'na';
    }).length;
    return { card, ci, overallPct, scores, missingCount };
  });

  // Sort card scores for percentile ranking
  const scored = cardScores.filter(c => c.overallPct !== null).sort((a,b) => b.overallPct - a.overallPct);
  const meanOverall = scored.length ? scored.reduce((a,b)=>a+b.overallPct,0)/scored.length : 0.5;
  const strongThresh = meanOverall + 0.15;
  const weakThresh   = meanOverall - 0.15;

  // Assign tier to each card
  cardScores.forEach(cs => {
    if (cs.overallPct === null) { cs.tier = 'incomplete'; return; }
    const rank = scored.indexOf(cs);
    const pctile = 1 - rank / Math.max(1, scored.length - 1);
    cs.pctile = pctile;
    if (cs.overallPct >= strongThresh)     cs.tier = 'strong';
    else if (cs.overallPct >= meanOverall) cs.tier = 'good';
    else if (cs.overallPct >= weakThresh)  cs.tier = 'average';
    else                                   cs.tier = 'weak';
  });

  // Deck-level metrics
  const spreadScores = catStats.filter(c => c.spread !== null).map(c => c.spreadPct);
  const avgSpread = spreadScores.length ? spreadScores.reduce((a,b)=>a+b,0)/spreadScores.length : 0;
  const fillRate = validCards.reduce((acc, card) => {
    const filled = cats.filter(cat => {
      const raw = card.stats[cat];
      return raw !== '' && raw !== undefined;
    }).length;
    return acc + filled;
  }, 0) / Math.max(1, validCards.length * cats.length);

  // Deck health score (0–100)
  const health = Math.round(
    avgSpread * 50 +          // spread variety
    fillRate * 30 +           // completeness
    Math.min(1, N/30) * 20    // deck size bonus (30 cards = full score)
  );

  return { deckName, N, cats, catStats, cardScores, meanOverall, avgSpread, fillRate, health, validCards };
}


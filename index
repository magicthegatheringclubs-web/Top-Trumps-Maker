  /* PRINT */
  @media print {
    header, .sidebar, .cards-area-header, .card-list, .bottom-bar, .no-print { display: none !important; }
    body { background: white; }
    .main { grid-template-columns: 1fr; }
    .cards-area { padding: 0; }
    #print-preview { display: grid !important; grid-template-columns: repeat(4, 62mm); gap: 5mm; justify-content: start; }
  }

  /* PREVIEW PANEL */
  #print-preview {
    display: none;
    grid-template-columns: repeat(4, var(--card-w));
    grid-auto-rows: var(--card-h);
    gap: 16px;
    padding: 1.5rem;
    background: #e0dcd4;
    /* don't force full-height — let content size the container */
    min-height: 0;
    justify-content: center;
    align-content: start;
    align-items: start;
  }
  body.dark-mode #print-preview {
    background: #111013;
  }

  /* ===========================
     TRUMP CARD — 62mm × 100mm
     =========================== */
  .trump-card {
    width: var(--card-w);
    height: var(--card-h);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    page-break-inside: avoid;
    break-inside: avoid;
    position: relative;
    flex-shrink: 0;
  }

  /* Frame (corner radius) */
  .trump-card.frame-classic  { border-radius: 8px; }
  .trump-card.frame-sharp    { border-radius: 0; }
  .trump-card.frame-rounded  { border-radius: 16px; }
  .trump-card.frame-hex      { border-radius: 8px; clip-path: polygon(6px 0%, calc(100% - 6px) 0%, 100% 6px, 100% calc(100% - 6px), calc(100% - 6px) 100%, 6px 100%, 0% calc(100% - 6px), 0% 6px); }

  /* ── BORDERS ─────────────────────────────────────────────────────────
     All borders use real CSS border / outline / ::before so they print.
     Each style adds a visible frame *inside* the card boundary so
     nothing gets clipped. The card already has overflow:hidden.
  ───────────────────────────────────────────────────────────────────── */

  /* Shared ::before pseudo used by several border styles */
  .trump-card.border-thin::before,
  .trump-card.border-solid::before,
  .trump-card.border-thick::before,
  .trump-card.border-double::before,
  .trump-card.border-double::after,
  .trump-card.border-triple::before,
  .trump-card.border-triple::after,
  .trump-card.border-dashed::before,
  .trump-card.border-dotted::before,
  .trump-card.border-ornate::before,
  .trump-card.border-ornate::after {
    content: '';
    position: absolute;
    pointer-events: none;
    z-index: 20;
    border-radius: inherit;
  }

  /* None */
  .trump-card.border-none {}

  /* Thin — 1px white line, subtle */
  .trump-card.border-thin::before {
    inset: 3px;
    border: 1px solid rgba(255,255,255,0.55);
  }

  /* Solid — 2px clean white border */
  .trump-card.border-solid::before {
    inset: 3px;
    border: 2px solid rgba(255,255,255,0.85);
  }

  /* Thick — 4px bold border */
  .trump-card.border-thick::before {
    inset: 2px;
    border: 4px solid rgba(255,255,255,0.8);
  }

  /* Double — two lines with a gap */
  .trump-card.border-double::before {
    inset: 3px;
    border: 1.5px solid rgba(255,255,255,0.8);
  }
  .trump-card.border-double::after {
    inset: 7px;
    border: 1px solid rgba(255,255,255,0.5);
  }

  /* Triple — three nested lines */
  .trump-card.border-triple::before {
    inset: 2px;
    border: 1px solid rgba(255,255,255,0.9);
    box-shadow: inset 0 0 0 4px rgba(255,255,255,0.15), inset 0 0 0 5px rgba(255,255,255,0.6);
  }

  /* Dashed */
  .trump-card.border-dashed::before {
    inset: 4px;
    border: 2px dashed rgba(255,255,255,0.7);
  }

  /* Dotted */
  .trump-card.border-dotted::before {
    inset: 4px;
    border: 2px dotted rgba(255,255,255,0.7);
  }

  /* Ornate — outer rule + inner rule with dark gap */
  .trump-card.border-ornate::before {
    inset: 2px;
    border: 1.5px solid rgba(255,255,255,0.9);
  }
  .trump-card.border-ornate::after {
    inset: 5px;
    border: 1px solid rgba(255,255,255,0.4);
    box-shadow: inset 0 0 0 1px rgba(0,0,0,0.2);
  }

  /* Corner brackets — decorative corners only, no full border */
  .trump-card.border-corners::before {
    inset: 5px;
    border-color: rgba(255,255,255,0.85);
    border-style: solid;
    border-width: 2px 0 0 2px;
    border-radius: 3px 0 0 0;
    width: 12px; height: 12px;
  }
  .trump-card.border-corners::after {
    content: '';
    position: absolute;
    pointer-events: none;
    z-index: 20;
    bottom: 5px; right: 5px;
    width: 12px; height: 12px;
    border-color: rgba(255,255,255,0.85);
    border-style: solid;
    border-width: 0 2px 2px 0;
    border-radius: 0 0 3px 0;
  }

  /* Print: force colour output for backgrounds, SVG, images */
  @media print {
    .trump-card,
    .trump-card *,
    .trump-card::before,
    .trump-card::after {
      -webkit-print-color-adjust: exact !important;
      print-color-adjust: exact !important;
      color-adjust: exact !important;
    }
    .tt-stamp { display: block !important; visibility: visible !important; }
  }

  /* ── SPOTLIGHT CAROUSEL ─────────────────────────────────────────── */
  .spotlight-overlay {
    position: fixed; inset: 0; z-index: 2000;
    background: rgba(0,0,0,0.82);
    display: flex; align-items: center; justify-content: center;
    backdrop-filter: blur(6px);
    animation: spotlight-fade-in 0.18s ease;
  }
  @keyframes spotlight-fade-in { from { opacity:0 } to { opacity:1 } }

  .spotlight-inner {
    display: flex; align-items: center; gap: 20px;
    max-width: min(98vw, 900px);
    padding: 0 8px;
  }

  .spotlight-card-wrap {
    flex: 0 0 auto;
    /* Scale the 175×282 CSS card up to fill screen nicely */
    --sl-scale: min(calc((100vh - 140px) / 282px), calc((100vw - 180px) / 175px), 2.8);
    width:  calc(175px * var(--sl-scale));
    height: calc(282px * var(--sl-scale));
    position: relative;
  }
  .spotlight-card-wrap .trump-card {
    position: absolute; inset: 0;
    width: 100% !important; height: 100% !important;
    min-height: unset !important;
    transform-origin: top left;
    /* Scale the card from its native size up */
    transform: scale(var(--sl-scale));
    transform-origin: 0 0;
    /* Reset to native size so scale works cleanly */
    width: 175px !important;
    height: 282px !important;
  }

  .spotlight-arrow {
    background: rgba(255,255,255,0.12);
    border: 1px solid rgba(255,255,255,0.2);
    border-radius: 50%; width: 48px; height: 48px;
    display: flex; align-items: center; justify-content: center;
    font-size: 20px; color: #fff; cursor: pointer;
    flex-shrink: 0;
    transition: background 0.15s;
    touch-action: manipulation;
    user-select: none;
  }
  .spotlight-arrow:hover { background: rgba(255,255,255,0.25); }
  .spotlight-arrow:disabled { opacity: 0.25; cursor: default; }

  .spotlight-close {
    position: fixed; top: 16px; right: 20px;
    background: rgba(255,255,255,0.12); border: 1px solid rgba(255,255,255,0.2);
    border-radius: 50%; width: 40px; height: 40px;
    display: flex; align-items: center; justify-content: center;
    font-size: 20px; color: #fff; cursor: pointer;
    touch-action: manipulation;
  }
  .spotlight-close:hover { background: rgba(255,255,255,0.25); }

  .spotlight-counter {
    position: fixed; bottom: 24px; left: 50%; transform: translateX(-50%);
    color: rgba(255,255,255,0.55); font-size: 13px; letter-spacing: 0.05em;
    pointer-events: none;
  }

  /* Cards in preview are clickable */
  #print-preview .trump-card {
    cursor: pointer;
    transition: transform 0.15s, box-shadow 0.15s;
  }
  #print-preview .trump-card:hover {
    transform: translateY(-3px) scale(1.02);
    box-shadow: 0 12px 32px rgba(0,0,0,0.4);
  }


  /* Card name — top, prominent */
  .card-name-banner {
    padding: 7px 10px 5px;
    font-size: 13px;
    font-weight: 800;
    letter-spacing: -0.3px;
    line-height: 1.2;
    color: #fff;
    flex-shrink: 0;
  }

  /* Image zone */
  .card-image {
    width: 100%;
    flex: 0 0 108px;
    background: rgba(0,0,0,0.2);
    display: flex; align-items: center; justify-content: center;
    overflow: hidden;
    font-size: 36px;
    color: rgba(255,255,255,0.2);
    position: relative;
  }
  /* With file strip: image can shrink to give the strip all the space it needs */
  .has-file .card-image { flex: 1 1 80px; min-height: 60px; max-height: 108px; }
  .card-image img { width: 100%; height: 100%; object-fit: cover; }
  .tt-stamp-canvas {
    position: absolute; bottom: 6px; right: 6px;
    width: 38px; height: 38px; z-index: 10; pointer-events: none;
    filter: drop-shadow(0 1px 3px rgba(0,0,0,0.7));
    border-radius: 50%;
  }
  /* Keep old SVG class in case any remain */
  .btn-tt-toggle {
    display: inline-flex; align-items: center; gap: 6px;
    border: 1px solid var(--border); border-radius: 7px;
    padding: 5px 10px; font-size: 12px; font-weight: 600;
    cursor: pointer; background: var(--surface); color: var(--text2);
    transition: border-color 0.15s, background 0.15s, color 0.15s;
    touch-action: manipulation; user-select: none; white-space: nowrap;
  }
  .btn-tt-toggle:hover { border-color: #e8b800; color: #b38600; }
  .btn-tt-toggle.active { border-color: #e8b800; background: #fffbe6; color: #b38600; }
  .btn-tt-toggle .tt-dot {
    width: 14px; height: 14px; border-radius: 50%;
    background: #e8b800; display: flex; align-items: center; justify-content: center;
    font-size: 7px; font-weight: 900; color: #000; line-height: 1; flex-shrink: 0;
  }

  /* Top Trumps File strip */
  .card-file-strip {
    padding: 4px 8px 5px;
    font-size: 7px;
    font-style: italic;
    line-height: 1.3;
    color: rgba(255,255,255,0.82);
    background: rgba(0,0,0,0.22);
    border-top: 1px solid rgba(255,255,255,0.1);
    border-bottom: 1px solid rgba(255,255,255,0.1);

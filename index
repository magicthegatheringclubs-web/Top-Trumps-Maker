// ============ UNDO / REDO ============
let history = [];
let historyIndex = -1;
const MAX_HISTORY = 50;

let _deckNameSnapshotTimer = null;
function debouncedDeckNameSnapshot() {
  clearTimeout(_deckNameSnapshotTimer);
  _deckNameSnapshotTimer = setTimeout(snapshot, 600);
}

function snapshot() {
  const deckName = document.getElementById('deck-name')?.value ?? '';
  // Serialise manualStats Sets as arrays for JSON
  const serialisedCards = cards.map(c => ({ ...c, manualStats: c.manualStats ? [...c.manualStats] : [] }));
  const state = JSON.stringify({ cats, catRanges, cards: serialisedCards, cardGroups, bgColor, accentColor, frameStyle, borderStyle, themeStyle, showBars, filePos, deckName });
  // Drop any forward history
  history = history.slice(0, historyIndex + 1);
  history.push(state);
  if (history.length > MAX_HISTORY) history.shift();
  historyIndex = history.length - 1;
  updateUndoRedoBtns();
}

function updateUndoRedoBtns() {
  document.getElementById('undo-btn').disabled = historyIndex <= 0;
  document.getElementById('redo-btn').disabled = historyIndex >= history.length - 1;
}

function undo() {
  if (historyIndex <= 0) return;
  historyIndex--;
  restoreSnapshot(history[historyIndex]);
}

function redo() {
  if (historyIndex >= history.length - 1) return;
  historyIndex++;
  restoreSnapshot(history[historyIndex]);
}

function restoreSnapshot(json) {
  const s = JSON.parse(json);
  cats = s.cats; catRanges = s.catRanges || {};
  if (s.cardGroups && Array.isArray(s.cardGroups) && s.cardGroups.length) cardGroups = s.cardGroups;
  // Restore manualStats arrays back into Sets; ensure group field exists
  cards = s.cards.map(c => ({ ...c, group: c.group || cardGroups[0] || 'Main', manualStats: new Set(c.manualStats || []) }));

  // Restore theme/display state
  bgColor     = s.bgColor     ?? bgColor;
  accentColor = s.accentColor ?? accentColor;
  frameStyle  = s.frameStyle  ?? frameStyle;
  borderStyle = s.borderStyle ?? borderStyle;
  themeStyle  = s.themeStyle  ?? themeStyle;
  showBars    = s.showBars    ?? showBars;
  filePos     = s.filePos     ?? filePos;

  // Sync all UI controls to the restored values
  document.querySelectorAll('.theme-option').forEach(o => o.classList.toggle('active', o.dataset.theme === themeStyle));
  document.querySelectorAll('#frame-options .style-option').forEach(o => o.classList.toggle('active', o.dataset.frame === frameStyle));
  document.querySelectorAll('#border-options .style-option').forEach(o => o.classList.toggle('active', o.dataset.border === borderStyle));
  document.getElementById('bars-off-btn').classList.toggle('active', !showBars);
  document.getElementById('bars-on-btn').classList.toggle('active',  showBars);
  document.getElementById('file-top-btn').classList.toggle('active',    filePos === 'top');
  document.getElementById('file-bottom-btn').classList.toggle('active', filePos === 'bottom');
  document.getElementById('custom-bg-color').value = bgColor;
  document.getElementById('custom-accent-color').value = accentColor;
  renderColorSwatches();

  if (s.deckName !== undefined) document.getElementById('deck-name').value = s.deckName;

  renderGroups(); renderCats(); renderCardList();
  updateUndoRedoBtns();
  if (previewing) previewDeck();
}


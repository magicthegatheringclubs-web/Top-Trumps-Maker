        <span class="az-scorecard-val ${r.avgSpread>=0.4?'color-good':r.avgSpread>=0.2?'color-ok':'color-warn'}">${Math.round(r.avgSpread*100)}<span style="font-size:16px;font-weight:500">%</span></span>
        <span class="az-scorecard-sub">Avg stat spread across range</span>
      </div>
      <div class="az-scorecard">
        <span class="az-scorecard-label">Decisive stats${info("Stats with spread ≥ 30% of their range. These are the categories most likely to decide a winner each round — you want several of these.")}</span>
        <span class="az-scorecard-val">${decisiveCats}<span style="font-size:14px;font-weight:500"> / ${r.cats.length}</span></span>
        <span class="az-scorecard-sub">Stats with good spread</span>
      </div>
      <div class="az-scorecard" style="grid-column: 1 / -1;">
        <span class="az-scorecard-label">Card tiers${info("How cards rank relative to each other based on their overall stat averages as a % of their ranges.")}</span>
        ${(()=>{
          const counts = {strong:0,good:0,average:0,weak:0,incomplete:0};
          r.cardScores.forEach(cs => { if (counts[cs.tier] !== undefined) counts[cs.tier]++; });
          const items = [
            {key:'strong',    label:'Strong',     emoji:'⭐', cls:'tp-strong'},
            {key:'good',      label:'Good',       emoji:'👍', cls:'tp-good'},
            {key:'average',   label:'Average',    emoji:'〰',  cls:'tp-average'},
            {key:'weak',      label:'Weak',       emoji:'⚠',  cls:'tp-weak'},
            {key:'incomplete',label:'Incomplete', emoji:'❓', cls:'tp-incomplete'},
          ];
          return `<div class="az-tier-row" style="margin-top:8px;">
            ${items.map(it => counts[it.key] > 0 ? `
              <div class="az-tier-pill ${it.cls}">
                <span class="tp-count">${counts[it.key]}</span>
                <span class="tp-label">${it.emoji} ${it.label}</span>
              </div>` : '').join('')}
          </div>`;
        })()}
      </div>
    </div>
  </section>`;

  // ── Section 2: Category breakdown ──
  html += `
  <section>
    <p class="az-section-title">Stats breakdown</p>
    <div class="az-cat-table">
      <div class="az-cat-row az-cat-head">
        <div class="az-cat-cell">Stat</div>
        <div class="az-cat-cell">🏆 Best</div>
        <div class="az-cat-cell">📉 Worst</div>
        <div class="az-cat-cell az-cat-spread">Spread${info("How far apart the highest and lowest values are, as % of the stat's range. Green ≥30% (decisive), amber 15–30% (moderate), red <15% (dull — rarely decides a winner).")}</div>
        <div class="az-cat-cell az-cat-head-spread">Average${info("The mean value for this stat across all cards that have it filled in.")}</div>
      </div>`;

  r.catStats.forEach(cs => {
    if (!cs.vals.length) {
      html += `<div class="az-cat-row">
        <div class="az-cat-cell" style="font-weight:600">${esc(cs.cat)}</div>
        <div class="az-cat-cell" colspan="4" style="color:var(--text2);font-size:12px">No data</div>
      </div>`;
      return;
    }
    const spreadBarPct = Math.round(cs.spreadPct * 100);
    const spreadColor  = cs.isDecisive ? '#22c55e' : cs.isDull ? '#ef4444' : '#f59e0b';
    html += `<div class="az-cat-row">
      <div class="az-cat-cell" style="font-weight:600">${esc(cs.cat)}${cs.hasMissing ? ` <span style="font-size:10px;color:var(--text2)">(${cs.missing} missing)</span>` : ''}</div>
      <div class="az-cat-cell az-winner">✦ ${esc(cs.winner.name)} <span style="font-weight:400;color:var(--text2)">(${cs.winner.val})</span></div>
      <div class="az-cat-cell az-loser">▽ ${esc(cs.loser.name)} <span style="font-weight:400;color:var(--text2)">(${cs.loser.val})</span></div>
      <div class="az-cat-cell az-cat-spread">
        <div class="az-spread-bar">
          <div class="az-spread-track"><div class="az-spread-fill" style="width:${spreadBarPct}%;background:${spreadColor}"></div></div>
          <span style="font-size:11px;font-weight:600;color:${spreadColor};min-width:32px">${spreadBarPct}%</span>
        </div>
      </div>
      <div class="az-cat-cell az-cat-head-spread" style="font-weight:600">${Math.round(cs.mean)}</div>
    </div>`;
  });

  html += `</div>
  </section>`;

  // ── Section 3: Per-card report ──
  html += `<section><p class="az-section-title">Card-by-card report${info("Each card is rated relative to the rest of the deck. ▲ = above average for that stat, ▼ = below average, – = close to the mean.")}</p><div class="az-card-grid">`;

  r.cardScores.forEach(cs => {
    const { card, overallPct, tier, pctile, missingCount } = cs;
    const tierLabel = { strong:'⭐ Strong', good:'👍 Good', average:'〰 Average', weak:'⚠ Weak', incomplete:'❓ Incomplete' };
    const tierTip = { strong:'Top 35% overall — strong across most stats.', good:'Above the deck average overall.', average:'Close to the deck mean — a solid, mid-range card.', weak:'Below the deck average overall — may struggle in head-to-head rounds.', incomplete:'Has unfilled stats — hard to rank fairly.' };
    const tierBadge = { strong:'badge-strong', good:'badge-good', average:'badge-average', weak:'badge-weak', incomplete:'badge-average' };

    // Per-stat rows with comparison to avg
    let statRows = '';
    cats.forEach(cat => {
      const raw = card.stats[cat];
      const range = catRanges[cat] || [0,100];
      const span  = range[1] - range[0];
      const cs2 = r.catStats.find(c => c.cat === cat);
      const isNA = raw === 'na';
      const isEmpty = raw === '' || raw === undefined;
      const val = isNA || isEmpty ? null : +raw;

      let barPct = 0, barColor = '#94a3b8', flag = '', valDisplay = isNA ? 'N/A' : '–';
      if (val !== null && span > 0) {
        barPct = Math.max(0, Math.min(100, ((val - range[0]) / span) * 100));
        valDisplay = val;
        // Compare to mean
        if (cs2 && cs2.mean !== null) {
          const diff = val - cs2.mean;
          const threshold = span * 0.12;
          if (diff > threshold)       { flag = '▲'; barColor = '#22c55e'; }
          else if (diff < -threshold) { flag = '▼'; barColor = '#ef4444'; }
          else                        { flag = '–'; barColor = '#f59e0b'; }
        }
      }

      statRows += `<div class="az-card-stat-row">
        <span class="az-card-stat-name">${esc(cat)}</span>
        <div class="az-card-stat-bar-wrap">
          <div class="az-card-stat-bar-fill" style="width:${barPct}%;background:${barColor}"></div>
        </div>
        <span class="az-card-stat-val" style="color:${barColor}">${valDisplay}</span>
        <span class="az-card-stat-flag" style="color:${barColor}">${flag}</span>
      </div>`;
    });

    // Suggestions
    const suggestions = buildSuggestions(card, cs, r);
    const suggHtml = suggestions.length
      ? suggestions.map(s => `<div class="az-suggestion"><span class="az-suggestion-icon">${s.icon}</span><span>${s.text}</span></div>`).join('')
      : `<div class="az-suggestion"><span class="az-suggestion-icon">✅</span><span>This card looks well-balanced.</span></div>`;

    html += `<div class="az-card">
      <div class="az-card-head">
        <span class="az-card-name">${esc(card.name)}</span>
        <span class="az-card-badge ${tierBadge[tier] || 'badge-average'}">${tierLabel[tier] || tier}</span>${info(tierTip[tier] || '', true)}
      </div>
      <div class="az-card-stats">${statRows}</div>
      <div class="az-card-suggestions">${suggHtml}</div>
    </div>`;
  });

  html += `</div></section>`;

  // ── Section 4: Overall insights ──
  const insights = buildDeckInsights(r);
  html += `<section>
    <p class="az-section-title">Gameplay insights &amp; suggestions${info("Tips based on the overall shape of your deck — things that affect how fun and competitive the game will feel to play.")}</p>
    <div class="az-insights">
      ${insights.map(ins => `<div class="az-insight"><span class="az-insight-icon">${ins.icon}</span><div>${ins.text}</div></div>`).join('')}
    </div>
  </section>`;

  return html;
}

// ── Per-card suggestions ─────────────────────────────────────────────────────
function buildSuggestions(card, cs, r) {
  const suggestions = [];
  const { overallPct, tier, missingCount } = cs;

  if (missingCount > 0) {
    suggestions.push({ icon: '❓', text: `Missing ${missingCount} stat${missingCount>1?'s':''}. Fill these in or mark as N/A.` });
  }

  cats.forEach(cat => {
    const raw = card.stats[cat];
    if (raw === '' || raw === undefined || raw === 'na') return;
    const val = +raw;
    const range = catRanges[cat] || [0,100];
    const span  = range[1] - range[0];
    const cs2 = r.catStats.find(c => c.cat === cat);
    if (!cs2 || cs2.mean === null || span === 0) return;

    const diff = val - cs2.mean;
    const threshold = span * 0.12;

    if (diff < -threshold * 2.5) {
      suggestions.push({ icon: '📉', text: `<strong>${cat}</strong> is well below average (${val} vs avg ${Math.round(cs2.mean)}). Consider raising it to make this card more competitive in this stat.` });
    }
    if (val === cs2.winner?.val && cs2.isDull) {
      suggestions.push({ icon: '💡', text: `<strong>${cat}</strong> has low spread across the deck — even though this card leads, the stat may not be decisive in gameplay. Consider widening the range.` });
    }
  });

  if (tier === 'strong' && missingCount === 0) {
    suggestions.push({ icon: '⚖️', text: `This card is one of the stronger ones overall. Make sure it has at least one below-average stat to keep games interesting.` });
  }
  if (tier === 'weak') {
    const bestCat = cats.reduce((best, cat) => {
      const raw = card.stats[cat];
      if (raw === '' || raw === undefined || raw === 'na') return best;
      const cs2 = r.catStats.find(c => c.cat === cat);
      if (!cs2 || cs2.mean === null) return best;
      const diff = (+raw) - cs2.mean;
      return (!best || diff > best.diff) ? { cat, diff } : best;
    }, null);
    if (bestCat && bestCat.diff >= 0) {
      suggestions.push({ icon: '🎯', text: `This card is below average overall. Its strongest stat is <strong>${bestCat.cat}</strong> — consider building your strategy around that.` });
    } else {
      suggestions.push({ icon: '🔧', text: `This card is below average in all stats. Consider boosting at least one stat so it has a chance to win a round.` });
    }
  }

  return suggestions;
}

// ── Deck-level insights ───────────────────────────────────────────────────────
function buildDeckInsights(r) {
  const insights = [];
  const esc = s => String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');

  // Deck size
  if (r.N < 5) insights.push({ icon: '🃏', text: `Your deck only has <strong>${r.N} cards</strong>. Standard Top Trumps decks have 30 cards — consider adding more for a proper game.` });
  else if (r.N < 15) insights.push({ icon: '🃏', text: `<strong>${r.N} cards</strong> is playable but on the small side. Standard Top Trumps decks have 30 cards.` });
  else if (r.N < 25) insights.push({ icon: '🃏', text: `<strong>${r.N} cards</strong> — decent size. A full standard deck is 30 cards.` });
  else insights.push({ icon: '🃏', text: `<strong>${r.N} cards</strong> — great deck size, close to the standard 30-card Top Trumps format!` });

  // Dull categories
  const dull = r.catStats.filter(c => c.isDull && c.vals.length > 0);
  if (dull.length) {
    insights.push({ icon: '⚠️', text: `The stat${dull.length>1?'s':''} <strong>${dull.map(c=>esc(c.cat)).join(', ')}</strong> ${dull.length>1?'have':'has'} very low spread (under 15% of the range). These stats will rarely decide a winner — widen the values across your cards.` });
  }

  // Decisive categories
  const decisive = r.catStats.filter(c => c.isDecisive && c.vals.length > 0);
  if (decisive.length) {
    insights.push({ icon: '⚡', text: `<strong>${decisive.map(c=>esc(c.cat)).join(', ')}</strong> ${decisive.length>1?'have':'has'} good spread — ${decisive.length>1?'these stats':'this stat'} will create exciting decisions in gameplay.` });
  }

  // Dominant card
  const topCard = r.cardScores.filter(c => c.overallPct !== null).sort((a,b) => b.overallPct - a.overallPct)[0];
  const botCard = r.cardScores.filter(c => c.overallPct !== null).sort((a,b) => a.overallPct - b.overallPct)[0];
  if (topCard && topCard.overallPct > 0.80) {
    insights.push({ icon: '👑', text: `<strong>${esc(topCard.card.name)}</strong> is very powerful overall (${Math.round(topCard.overallPct*100)}th percentile). Consider giving it at least one low stat as a weakness to keep the game balanced.` });
  }
  if (botCard && botCard.overallPct < 0.20) {
    insights.push({ icon: '🩹', text: `<strong>${esc(botCard.card.name)}</strong> is significantly weaker than the rest. Try boosting its best stat so it can still win at least one category.` });
  }

  // Missing stats
  const totalMissing = r.cardScores.reduce((a, cs) => a + cs.missingCount, 0);
  if (totalMissing > 0) {
    insights.push({ icon: '📝', text: `<strong>${totalMissing} stat value${totalMissing>1?'s are':' is'} missing</strong> across your deck. Missing stats are treated as losses in the game — fill them in for a better experience.` });
  }

  // Good balance
  if (r.avgSpread >= 0.35 && r.health >= 70) {
    insights.push({ icon: '✅', text: `Your deck looks well-balanced overall — good variety of stat values and a healthy spread. It should make for a fun game!` });
  }

  // Category count advice
  if (r.cats.length < 3) {
    insights.push({ icon: '📋', text: `Only <strong>${r.cats.length} stat${r.cats.length>1?'s':''}</strong> per card makes the game very short. Adding 4–6 stats gives players more to think about each turn.` });
  } else if (r.cats.length > 7) {
    insights.push({ icon: '📋', text: `<strong>${r.cats.length} stats</strong> per card is a lot — games may take longer. Classic Top Trumps usually has 5–6 stats.` });
  }

  return insights;
}

</script>
<div id="az-tooltip"></div>
<script>
(function() {
  const tip = document.getElementById('az-tooltip');
  let hideTimer;

  document.addEventListener('mouseover', e => {
    const el = e.target.closest('.az-info');
    if (!el) return;
    clearTimeout(hideTimer);
    const text = el.dataset.tip;
    if (!text) return;

    tip.textContent = text;
    tip.classList.add('visible');
    positionTip(el);
  });

  document.addEventListener('mousemove', e => {
    const el = e.target.closest('.az-info');
    if (!el) return;
    positionTip(el);
  });

  document.addEventListener('mouseout', e => {
    if (e.target.closest('.az-info')) {
      hideTimer = setTimeout(() => tip.classList.remove('visible'), 80);
    }
  });

  function positionTip(el) {
    const r = el.getBoundingClientRect();
    const tipW = 220, tipH = tip.offsetHeight || 60;
    const margin = 8;

    // Prefer above; flip below if not enough room
    let top = r.top - tipH - 10;
    if (top < margin) top = r.bottom + 10;

    // Horizontally centre on icon, clamp to viewport
    let left = r.left + r.width / 2 - tipW / 2;
    left = Math.max(margin, Math.min(left, window.innerWidth - tipW - margin));

    tip.style.top  = top  + 'px';
    tip.style.left = left + 'px';
  }
})();
</script>


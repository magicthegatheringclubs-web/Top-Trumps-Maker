function showRankingForCat(catIdx) {
  document.querySelectorAll('.az-rank-cat-btn').forEach(b => {
    b.classList.toggle('active', +b.dataset.catIdx === catIdx);
  });
  const wrap = document.getElementById('rank-table-wrap');
  if (!_analyzeReport || !wrap) return;
  const r = _analyzeReport;
  const esc = s => String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
  const medal = pos => pos === 1 ? 'gold' : pos === 2 ? 'silver' : pos === 3 ? 'bronze' : '';

  if (catIdx === -1) {
    // Overall ranking
    const scored = r.cardScores.filter(cs => cs.overallPct !== null).sort((a,b) => b.overallPct - a.overallPct);
    const unscored = r.cardScores.filter(cs => cs.overallPct === null);
    const tierColour = t => t==='strong'?'#22c55e':t==='good'?'#3b82f6':t==='average'?'#f59e0b':'#ef4444';
    const rows = scored.map((cs, i) => {
      const pos = i + 1;
      const pct = Math.round(cs.overallPct * 100);
      return `<div class="az-rank-row">
        <div class="az-rank-pos ${medal(pos)}">${pos===1?'🥇':pos===2?'🥈':pos===3?'🥉':pos}</div>
        <div class="az-rank-name" title="${esc(cs.card.name)}">${esc(cs.card.name)}</div>
        <div class="az-rank-bar-wrap"><div class="az-rank-bar-fill" data-pct="${pct}" style="background:${tierColour(cs.tier)}"></div></div>
        <div class="az-rank-val">${pct}%</div>
      </div>`;
    }).join('');
    const naRows = unscored.map(cs => `<div class="az-rank-row">
        <div class="az-rank-pos">—</div>
        <div class="az-rank-name">${esc(cs.card.name)}</div>
        <div style="font-size:11px;color:var(--text2);grid-column:3/5">No stats filled</div>
      </div>`).join('');
    wrap.innerHTML = `
      <div class="az-rank-row rank-header"><div></div><div>Card</div><div>Overall score</div><div style="text-align:right">Score</div></div>
      <div class="az-rank-table">${rows}${naRows}</div>`;
  } else {
    // Single stat ranking
    const cat = r.cats[catIdx];
    const catStat = r.catStats[catIdx];
    const range = catStat.range;
    const span = range[1] - range[0] || 1;
    const accentColor = getComputedStyle(document.documentElement).getPropertyValue('--accent').trim() || '#3b82f6';
    const entries = r.validCards.map(card => {
      const raw = card.stats[cat];
      const val = (raw !== '' && raw !== undefined && raw !== 'na') ? +raw : null;
      return { card, val };
    });
    entries.sort((a,b) => {
      if (a.val === null && b.val === null) return 0;
      if (a.val === null) return 1;
      if (b.val === null) return -1;
      return b.val - a.val;
    });
    let pos = 0, lastVal = null;
    const rows = entries.map(({ card, val }) => {
      if (val !== null) {
        if (val !== lastVal) { pos++; lastVal = val; }
        const barPct = Math.round((val - range[0]) / span * 100);
        return `<div class="az-rank-row">
          <div class="az-rank-pos ${medal(pos)}">${pos===1?'🥇':pos===2?'🥈':pos===3?'🥉':pos}</div>
          <div class="az-rank-name" title="${esc(card.name)}">${esc(card.name)}</div>
          <div class="az-rank-bar-wrap"><div class="az-rank-bar-fill" data-pct="${barPct}" style="background:${accentColor}"></div></div>
          <div class="az-rank-val">${val}</div>
        </div>`;
      } else {
        return `<div class="az-rank-row">
          <div class="az-rank-pos">—</div>
          <div class="az-rank-name">${esc(card.name)}</div>
          <div></div><div class="az-rank-na">N/A</div>
        </div>`;
      }
    }).join('');
    wrap.innerHTML = `
      <div class="az-rank-row rank-header"><div></div><div>Card</div><div>${esc(cat)} (${range[0]}–${range[1]})</div><div style="text-align:right">Value</div></div>
      <div class="az-rank-table">${rows}</div>`;
  }

  requestAnimationFrame(() => {
    wrap.querySelectorAll('.az-rank-bar-fill[data-pct]').forEach(el => { el.style.width = el.dataset.pct + '%'; });
  });
}


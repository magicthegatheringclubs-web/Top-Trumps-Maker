const LICENSE_API = 'https://tt-backend-ikeu.onrender.com';
const FREE_CARD_LIMIT  = 8;
const FREE_THEMES     = ['classic', 'retro', 'paper'];

let isPremium = false;

function checkStoredLicense() {
  const stored = localStorage.getItem('tt_license');
  if (!stored) return;
  try {
    const { key, tier } = JSON.parse(stored);
    if (key && tier === 'lifetime') {
      isPremium = true;
      updatePremiumUI();
    }
  } catch {}
}

async function activateLicense(key) {
  const clean = key.trim().toUpperCase();
  if (!clean) return showLicenseError('Please enter your license key.');

  const btn = document.getElementById('license-submit-btn');
  btn.textContent = 'Checking…'; btn.disabled = true;

  try {
    const res  = await fetch(`${LICENSE_API}/validate`, {
      method:  'POST',
      headers: { 'Content-Type': 'application/json' },
      body:    JSON.stringify({ key: clean }),
    });
    const data = await res.json();

    if (data.valid && data.tier === 'lifetime') {
      localStorage.setItem('tt_license', JSON.stringify({ key: clean, tier: 'lifetime', email: data.email }));
      isPremium = true;
      closeLicenseModal();
      updatePremiumUI();
      showPremiumToast();
    } else {
      showLicenseError(data.error || 'Invalid key. Check you entered it correctly.');
    }
  } catch (e) {
    showLicenseError('Could not reach the license server. Check your internet connection.');
  } finally {
    btn.textContent = 'Activate'; btn.disabled = false;
  }
}

function deactivateLicense() {
  localStorage.removeItem('tt_license');
  isPremium = false;
  updatePremiumUI();
}

function updatePremiumUI() {
  // Badge in header
  const badge = document.getElementById('premium-badge');
  if (badge) badge.style.display = isPremium ? 'inline-flex' : 'none';

  // Unlock button
  const unlockBtn = document.getElementById('unlock-btn');
  if (unlockBtn) unlockBtn.style.display = isPremium ? 'none' : '';

  // Bottom bar buttons — show/hide for non-premium
  const printBtn = document.getElementById('print-btn');
  if (printBtn) printBtn.style.opacity = isPremium ? '' : '0.45';
  if (printBtn) printBtn.title = isPremium ? 'Download cards (ZIP)' : '🔒 Premium feature — unlock to download';

  const analyzeBtn = document.getElementById('analyze-btn');
  if (analyzeBtn) analyzeBtn.style.opacity = isPremium ? '' : '0.45';
  if (analyzeBtn) analyzeBtn.title = isPremium ? 'Analyze deck (A)' : '🔒 Premium feature';

  // Stat bars option
  const barsOn = document.getElementById('bars-on-btn');
  if (barsOn) {
    const lock = barsOn.querySelector('.premium-lock');
    if (lock) lock.style.display = isPremium ? 'none' : '';
    barsOn.title = isPremium ? '' : '🔒 Premium feature';
  }

  // Theme locks — mark premium themes with a lock icon
  document.querySelectorAll('.theme-option[data-theme]').forEach(opt => {
    const t = opt.dataset.theme;
    const isLocked = !isPremium && !FREE_THEMES.includes(t);
    opt.classList.toggle('premium-locked', isLocked);
  });

  // Bleed toggle
  const bleedLabel = document.getElementById('bleed-toggle-label');
  if (bleedLabel) bleedLabel.classList.toggle('premium-locked', !isPremium);

  // Analyze button
  if (analyzeBtn) {
    analyzeBtn.title = isPremium ? 'Analyze deck (A)' : '🔒 Premium — analyze your deck';
  }

  // Manage license panel (shown when premium is active)
  let manageEl = document.getElementById('license-manage-panel');
  const sidebar = document.querySelector('.sidebar-inner') || document.querySelector('.sidebar');
  if (isPremium && sidebar && !manageEl) {
    manageEl = document.createElement('div');
    manageEl.id = 'license-manage-panel';
    manageEl.className = 'license-manage no-print';
    const stored = JSON.parse(localStorage.getItem('tt_license') || '{}');
    manageEl.innerHTML = `<div><strong>⭐ Premium active</strong><br>${stored.email || 'Lifetime license'}</div>
      <span class="deactivate-link" onclick="if(confirm('Deactivate premium on this device?'))deactivateLicense()">Deactivate</span>`;
    sidebar.appendChild(manageEl);
  } else if (!isPremium && manageEl) {
    manageEl.remove();
  }

  // Card count guard — show warning if over limit
  updateCardLimitUI();
}

function updateCardLimitUI() {
  const warning = document.getElementById('card-limit-warning');
  if (!warning) return;
  const over = !isPremium && cards.length > FREE_CARD_LIMIT;
  warning.style.display = over ? 'flex' : 'none';
  warning.querySelector('span').textContent =
    `Free plan: ${cards.length}/${FREE_CARD_LIMIT} cards. Upgrade for unlimited.`;
}

function showLicenseError(msg) {
  const el = document.getElementById('license-error');

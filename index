  /* Stats — flex:1 takes remaining space, stats distribute evenly within it */
  .card-stats-list {
    flex: 1;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    min-height: 0;
  }
  .card-stat {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0 9px;

function renderColorSwatches() {
  const palette = THEME_PALETTES[themeStyle] || THEME_PALETTES.classic;

  const bgContainer = document.getElementById('bg-swatches');
  const accentContainer = document.getElementById('accent-swatches');
  if (!bgContainer || !accentContainer) return;

  // Remove old swatches (keep the custom picker at the end)
  bgContainer.querySelectorAll('.swatch').forEach(s => s.remove());
  accentContainer.querySelectorAll('.swatch').forEach(s => s.remove());

  const bgCustom = bgContainer.querySelector('.swatch-custom');
  const accCustom = accentContainer.querySelector('.swatch-custom');

  // Build bg swatches
  palette.bg.forEach(color => {
    const el = document.createElement('div');
    el.className = 'swatch' + (color === bgColor ? ' active' : '');
    el.dataset.color = color;
    el.style.background = color;
    // Light colours get a border so they're visible
    const [r,g,b] = [parseInt(color.slice(1,3),16), parseInt(color.slice(3,5),16), parseInt(color.slice(5,7),16)];
    if ((0.299*r+0.587*g+0.114*b)/255 > 0.7) el.style.border = '1px solid #ccc';
    el.addEventListener('click', () => setBgColor(color, el));
    bgContainer.insertBefore(el, bgCustom);
  });

  // Build accent swatches
  palette.accent.forEach(color => {
    const el = document.createElement('div');
    el.className = 'swatch' + (color === accentColor ? ' active' : '');
    el.dataset.color = color;
    el.style.background = color;
    const [r,g,b] = [parseInt(color.slice(1,3),16), parseInt(color.slice(3,5),16), parseInt(color.slice(5,7),16)];
    if ((0.299*r+0.587*g+0.114*b)/255 > 0.7) el.style.border = '1px solid #ccc';
    el.addEventListener('click', () => setAccentColor(color, el));
    accentContainer.insertBefore(el, accCustom);
  });

  // Sync custom pickers
  document.getElementById('custom-bg-color').value = bgColor;
  document.getElementById('custom-accent-color').value = accentColor;
}

function setTheme(t, el) {
  if (!isPremium && !FREE_THEMES.includes(t)) {
    openLicenseModal();
    const sub = document.getElementById('license-modal-sub');
    if (sub) sub.textContent = 'Premium themes unlock with lifetime access — just $10.';
    return;
  }
  snapshot();
  themeStyle = t;
  document.querySelectorAll('.theme-option').forEach(o => o.classList.remove('active'));
  if (el) el.classList.add('active');

  // Apply defaults for this theme
  const def = THEME_DEFAULTS[t] || { bg: '#1a3a6b', accent: '#ffffff' };
  bgColor = def.bg;
  accentColor = def.accent;

  // Re-render swatches for this theme's palette
  renderColorSwatches();
  refresh();
}

let _bgColorTimer = null;
function setBgColor(val, el) {
  if (el) {
    snapshot(); // swatch click: snapshot immediately
  } else {
    // color picker drag: debounce so we don't flood history on every pixel
    clearTimeout(_bgColorTimer);
    _bgColorTimer = setTimeout(snapshot, 600);
  }
  bgColor = val;
  document.querySelectorAll('#bg-swatches .swatch').forEach(s => s.classList.remove('active'));
  if (el) { el.classList.add('active'); }
  else {
    const match = document.querySelector(`#bg-swatches .swatch[data-color="${val}"]`);
    if (match) match.classList.add('active');
  }
  document.getElementById('custom-bg-color').value = val;
  refresh();
}

let _accentColorTimer = null;
function setAccentColor(val, el) {
  if (el) {
    snapshot();
  } else {
    clearTimeout(_accentColorTimer);
    _accentColorTimer = setTimeout(snapshot, 600);
  }
  accentColor = val;
  document.querySelectorAll('#accent-swatches .swatch').forEach(s => s.classList.remove('active'));

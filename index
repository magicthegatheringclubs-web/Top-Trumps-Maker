// ============ DOWNLOAD CARDS AS ZIP ============
// Physical card: 62 × 100 mm at 300 DPI → 732 × 1181 px
const CARD_PX_W = 732;
const CARD_PX_H = 1181;

// ---- Print bleed ----
// Printer requires 36px of bleed on each side at 300 DPI (72px added per
// dimension total) so the design prints edge-to-edge with no white gap
// once trimmed. The trim line then sits inset 36px from the image edge —
// this is the "safe area" for text/important content.
const BLEED_PX    = 36;
const BLEED_OUT_W = CARD_PX_W + BLEED_PX * 2; // 804
const BLEED_OUT_H = CARD_PX_H + BLEED_PX * 2; // 1253

// Takes a rendered card canvas (exactly CARD_PX_W × CARD_PX_H) and returns
// a new canvas padded out to BLEED_OUT_W × BLEED_OUT_H. The card itself is
// placed unchanged/undistorted in the centre; the added border strip is
// filled by stretching a thin sliver of each edge outward, so there's no
// hard white edge where the printer trims — just more of the same edge
// colour/pattern, which gets cut off anyway.
function addPrintBleed(srcCanvas) {
  const SW = srcCanvas.width, SH = srcCanvas.height;
  const B  = BLEED_PX;
  const out = document.createElement('canvas');
  out.width  = SW + B * 2;
  out.height = SH + B * 2;
  const ctx = out.getContext('2d');

  // Main card, centred, unmodified
  ctx.drawImage(srcCanvas, 0, 0, SW, SH, B, B, SW, SH);

  // Edges: stretch a 1px sliver from each side out into the bleed band
  ctx.drawImage(srcCanvas, 0, 0, SW, 1, B, 0, SW, B);           // top
  ctx.drawImage(srcCanvas, 0, SH - 1, SW, 1, B, B + SH, SW, B); // bottom
  ctx.drawImage(srcCanvas, 0, 0, 1, SH, 0, B, B, SH);           // left
  ctx.drawImage(srcCanvas, SW - 1, 0, 1, SH, B + SW, B, B, SH); // right

  // Corners: stretch the single corner pixel into each bleed corner square
  ctx.drawImage(srcCanvas, 0, 0, 1, 1, 0, 0, B, B);                     // top-left
  ctx.drawImage(srcCanvas, SW - 1, 0, 1, 1, B + SW, 0, B, B);           // top-right
  ctx.drawImage(srcCanvas, 0, SH - 1, 1, 1, 0, B + SH, B, B);           // bottom-left
  ctx.drawImage(srcCanvas, SW - 1, SH - 1, 1, 1, B + SW, B + SH, B, B); // bottom-right

  return out;
}

async function printDeck() {
  if (!requirePremium('ZIP download')) return;
  const deckName = (document.getElementById('deck-name').value || 'Top Trumps').trim();
  const btn = document.getElementById('print-btn');

  if (typeof JSZip === 'undefined') {
    alert('JSZip is still loading — please wait a moment and try again.');
    return;
  }

  // html2canvas must be available
  if (typeof html2canvas === 'undefined') {
    alert('Renderer is still loading — please wait a moment and try again.');
    return;
  }

  btn.disabled = true;
  btn.textContent = '⏳ Rendering…';

  const includeBleed = document.getElementById('bleed-toggle').checked;

  // Off-screen container sized exactly to one card
  // We render at 2× CSS pixels (each CSS px = 2 output px) for sharpness.
  // Card is --card-w × --card-h = 175px × 282px in CSS.
  // At scale=4.18... that gives us 732 × 1181 px canvas (300 DPI equivalent).
  const CSS_W = 175; // must match --card-w
  const CSS_H = 282; // must match --card-h
  // html2canvas internally multiplies our scale by window.devicePixelRatio,
  // so we divide it out to always get exactly CARD_PX_W × CARD_PX_H pixels.
  const dpr   = window.devicePixelRatio || 1;
  const SCALE = (CARD_PX_W / CSS_W) / dpr;

  const host = document.createElement('div');
  Object.assign(host.style, {
    position: 'fixed',
    left: '-9999px', top: '0px',
    width:  CSS_W + 'px',
    height: CSS_H + 'px',
    overflow: 'visible',
    zIndex: '-1',
  });
  document.body.appendChild(host);

  try {
    const zip = new JSZip();
    const folder = zip.folder(deckName);

    for (let i = 0; i < cards.length; i++) {
      const card = cards[i];
      btn.textContent = `⏳ Rendering ${i + 1} / ${cards.length}…`;

      // Inject the card's HTML (same as preview) into the host
      host.innerHTML = buildTrumpCard(card);
      const cardEl = host.firstElementChild;

      // Force exact dimensions
      cardEl.style.width  = CSS_W + 'px';
      cardEl.style.height = CSS_H + 'px';
      cardEl.style.minHeight = CSS_H + 'px';
      cardEl.style.flexShrink = '0';

      // Draw stamp canvas and wait for images
      drawAllStamps(cardEl);
      await new Promise(r => setTimeout(r, 120));

      // Also wait for any <img> inside to finish loading
      const imgs = [...cardEl.querySelectorAll('img')];
      await Promise.all(imgs.map(img =>
        img.complete ? Promise.resolve() :
        new Promise(r => { img.onload = r; img.onerror = r; })
      ));

      // Render with html2canvas
      const canvas = await html2canvas(cardEl, {
        scale: SCALE,
        width:  CSS_W,
        height: CSS_H,
        useCORS: true,
        allowTaint: true,
        backgroundColor: null,
        logging: false,
        windowWidth: CSS_W,
        windowHeight: CSS_H,
        x: 0, y: 0,
      });

      const outCanvas = includeBleed ? addPrintBleed(canvas) : canvas;
      const pngBlob = await new Promise(r => outCanvas.toBlob(r, 'image/png'));
      const safeName = (card.name || `Card ${i + 1}`)
        .replace(/[^a-z0-9 _\-]/gi, '').trim().replace(/\s+/g, '-') || `card-${i + 1}`;
      folder.file(`${String(i + 1).padStart(2, '0')}-${safeName}.png`, pngBlob);
    }

    btn.textContent = '⏳ Building ZIP…';
    const zipBlob = await zip.generateAsync({ type: 'blob', compression: 'DEFLATE', compressionOptions: { level: 6 } });
    const url = URL.createObjectURL(zipBlob);
    const a = Object.assign(document.createElement('a'), {
      href: url,
      download: (deckName || 'top-trumps').toLowerCase().replace(/[^a-z0-9]+/g, '-') + '-cards' + (includeBleed ? '-bleed' : '-no-bleed') + '.zip',
    });
    document.body.appendChild(a); a.click(); a.remove();
    setTimeout(() => URL.revokeObjectURL(url), 10000);

  } catch (err) {
    console.error('Download failed:', err);
    alert('Something went wrong: ' + err.message);
  } finally {
    document.body.removeChild(host);
    btn.disabled = false;
    btn.textContent = '⬇ Download cards (ZIP)';
  }
}

// MiniZip — minimal ZIP builder for modern browsers (no compression, stored only)
// Supports: new MiniZip(), .folder(name), .file(name, blob/uint8array), .generateAsync({type:'blob'})
class MiniZip {
  constructor(prefix='') { this._prefix = prefix; this._entries = []; this._children = []; }
  folder(name) { const child = new MiniZip(this._prefix + name + '/'); this._children.push(child); return child; }
  file(name, data) { this._entries.push({ name: this._prefix + name, data }); }
  _allEntries() {
    return [...this._entries, ...this._children.flatMap(c => c._allEntries())];
  }
  async generateAsync({ type }) {
    const entries = this._allEntries();
    const enc = new TextEncoder();
    const parts = [];
    const centralDir = [];
    let offset = 0;

    for (const { name, data } of entries) {
      const nameBuf = enc.encode(name);
      let bytes;
      if (data instanceof Blob)       bytes = new Uint8Array(await data.arrayBuffer());
      else if (data instanceof ArrayBuffer) bytes = new Uint8Array(data);
      else if (data instanceof Uint8Array)  bytes = data;
      else throw new Error('Unsupported data type');

      const crc = crc32(bytes);
      const local = buildLocalHeader(nameBuf, bytes.length, crc);
      centralDir.push(buildCentralHeader(nameBuf, bytes.length, crc, offset));
      parts.push(local, bytes);
      offset += local.length + bytes.length;
    }

    const cdBuf = concat(centralDir);
    const eocd  = buildEOCD(entries.length, cdBuf.length, offset);
    const zip   = concat([...parts, cdBuf, eocd]);
    return type === 'blob' ? new Blob([zip], { type: 'application/zip' }) : zip;
  }
}

function u16(n) { const b=new Uint8Array(2); b[0]=n&0xff; b[1]=(n>>8)&0xff; return b; }
function u32(n) { const b=new Uint8Array(4); b[0]=n&0xff; b[1]=(n>>8)&0xff; b[2]=(n>>16)&0xff; b[3]=(n>>24)&0xff; return b; }
function concat(arrs) { const t=arrs.reduce((s,a)=>s+a.length,0); const o=new Uint8Array(t); let p=0; for(const a of arrs){o.set(a,p);p+=a.length;} return o; }

function buildLocalHeader(name, size, crc) {
  return concat([
    new Uint8Array([0x50,0x4b,0x03,0x04]), // sig
    u16(20),u16(0),u16(0),                 // version, flags, compression (stored)
    u16(0),u16(0),                          // mod time, date
    u32(crc), u32(size), u32(size),         // crc32, comp size, uncomp size
    u16(name.length), u16(0),              // name len, extra len
    name,
  ]);
}

function buildCentralHeader(name, size, crc, offset) {
  return concat([
    new Uint8Array([0x50,0x4b,0x01,0x02]), // sig
    u16(20),u16(20),u16(0),u16(0),         // ver made, ver needed, flags, compression
    u16(0),u16(0),                          // mod time, date
    u32(crc), u32(size), u32(size),         // crc32, comp size, uncomp size
    u16(name.length),u16(0),u16(0),         // name, extra, comment lens
    u16(0),u16(0),u32(0),                   // disk start, int attrs, ext attrs
    u32(offset),                            // local header offset
    name,
  ]);
}

function buildEOCD(count, cdSize, cdOffset) {
  return concat([
    new Uint8Array([0x50,0x4b,0x05,0x06]),  // sig
    u16(0),u16(0),                           // disk number, disk with CD
    u16(count),u16(count),                   // entries on disk, total entries
    u32(cdSize), u32(cdOffset),              // CD size, CD offset
    u16(0),                                  // comment length
  ]);
}

// CRC-32 table
const CRC_TABLE = (() => {
  const t = new Uint32Array(256);
  for(let i=0;i<256;i++){let c=i;for(let j=0;j<8;j++)c=c&1?0xEDB88320^(c>>>1):c>>>1;t[i]=c;}
  return t;
})();
function crc32(buf) {
  let crc = 0xFFFFFFFF;
  for(let i=0;i<buf.length;i++) crc = CRC_TABLE[(crc^buf[i])&0xff]^(crc>>>8);
  return (crc^0xFFFFFFFF)>>>0;
}


function attachCardListeners(list) {
  // Attach all listeners
  list.querySelectorAll('[data-action="toggle-collapse"]').forEach(btn => {
    btn.addEventListener('click', e => {
      e.stopPropagation();
      toggleCollapse(+btn.dataset.idx);
    });
  });
  // Clicking anywhere on a collapsed row expands it
  // (guard against interactive children so accidental triggers don't fire)
  list.querySelectorAll('.card-row.is-collapsed').forEach(row => {
    row.addEventListener('click', e => {
      // Ignore clicks on buttons, inputs, or anything with a data-action
      if (e.target.closest('button, input, select, textarea, a, [data-action]')) return;
      const idx = +row.dataset.cardIdx;
      if (!isNaN(idx)) toggleCollapse(idx);
    });
  });
  list.querySelectorAll('[data-action="card-name"]').forEach(inp => {
    inp.addEventListener('input', () => { cards[+inp.dataset.idx].name = inp.value; });
  });
  list.querySelectorAll('[data-action="card-file"]').forEach(ta => {
    ta.addEventListener('input', () => { cards[+ta.dataset.idx].file = ta.value; });
  });
  list.querySelectorAll('[data-action="remove-card"]').forEach(btn => {
    btn.addEventListener('click', () => removeCard(+btn.dataset.idx));
  });
  list.querySelectorAll('[data-action="randomize"]').forEach(btn => {
    btn.addEventListener('click', () => randomizeCard(+btn.dataset.idx));
  });
  list.querySelectorAll('[data-action="tt-toggle"]').forEach(btn => {
    btn.addEventListener('click', () => {
      if (!requirePremium('Top Trump stamp')) return;
      const i = +btn.dataset.idx;
      cards[i].topTrump = !cards[i].topTrump;
      btn.classList.toggle('active', cards[i].topTrump);
      snapshot();
      if (previewing) previewDeck();
    });
  });
  list.querySelectorAll('[data-action="incomplete-toggle"]').forEach(btn => {
    btn.addEventListener('click', () => {
      const i = +btn.dataset.idx;
      cards[i].incomplete = !cards[i].incomplete;
      btn.classList.toggle('active', cards[i].incomplete);
      // Update collapsed summary if visible
      const row = document.querySelector(`#card-list .card-row[data-card-idx="${i}"]`);
      if (row && row.classList.contains('is-collapsed')) {
        const nameEl = row.querySelector('.card-collapsed-name');
        if (nameEl) nameEl.innerHTML = escHtml(cards[i].name || 'Unnamed') + (cards[i].incomplete ? ' <span title="Marked incomplete" style="font-size:13px;">⚠️</span>' : '');
      }
      snapshot();
      if (previewing) previewDeck();
    });
  });
  list.querySelectorAll('[data-action="card-group"]').forEach(sel => {
    sel.addEventListener('change', () => {
      cards[+sel.dataset.idx].group = sel.value;
      snapshot();
    });
  });
  list.querySelectorAll('[data-action="clear-stats"]').forEach(btn => {
    btn.addEventListener('click', () => clearCardStats(+btn.dataset.idx));
  });
  list.querySelectorAll('[data-action="open-crop"]').forEach(el => {
    el.addEventListener('click', () => openCrop(+el.dataset.idx));
  });
  list.querySelectorAll('[data-action="img-upload"]').forEach(inp => {
    inp.addEventListener('change', () => handleImg(+inp.dataset.idx, inp));
  });
  list.querySelectorAll('[data-action="stat-input"]').forEach(inp => {
    inp.addEventListener('input', () => {
      const i = +inp.dataset.idx;
      const ci = +inp.dataset.ci;
      const cat = cats[ci];
      const raw = inp.value.trim();
      if (raw === '') {
        cards[i].stats[cat] = '';
        // Clearing removes the manual lock
        if (cards[i].manualStats) cards[i].manualStats.delete(cat);
        return;
      }
      const range = catRanges[cat] || [0, 100];
      const num = parseFloat(raw);
      if (!isNaN(num)) {
        cards[i].stats[cat] = Math.min(range[1], Math.max(range[0], num));
        // Mark as manually entered so randomize skips it
        if (!cards[i].manualStats) cards[i].manualStats = new Set();
        cards[i].manualStats.add(cat);
      }
    });
    inp.addEventListener('blur', () => {
      const i = +inp.dataset.idx;
      const ci = +inp.dataset.ci;
      const cat = cats[ci];
      const range = catRanges[cat] || [0, 100];
      const v = cards[i].stats[cat];
      if (v !== '' && v !== 'na' && v !== undefined) inp.value = v;
    });
  });
  list.querySelectorAll('[data-action="stat-na"]').forEach(btn => {
    btn.addEventListener('click', () => {
      const i = +btn.dataset.idx;
      const ci = +btn.dataset.ci;
      const cat = cats[ci];
      const isNa = cards[i].stats[cat] === 'na';
      cards[i].stats[cat] = isNa ? '' : 'na';
      // Surgical DOM update — never re-render the whole list during editing
      const inp = btn.previousElementSibling;
      if (inp) {
        inp.disabled = !isNa;
        inp.style.opacity = isNa ? '' : '0.35';
        inp.style.textDecoration = isNa ? '' : 'line-through';
        inp.value = isNa ? (cards[i].stats[cat] ?? '') : '';
      }
      btn.classList.toggle('is-na', !isNa);
      snapshot();
      if (previewing) previewDeck();
    });
  });
  // Drop zones (image upload)
  list.querySelectorAll('.drop-zone').forEach(zone => {
    const i = +zone.id.replace('drop-', '');
    zone.addEventListener('dragover', e => { e.preventDefault(); zone.classList.add('drag-active'); });
    zone.addEventListener('dragleave', () => zone.classList.remove('drag-active'));
    zone.addEventListener('drop', e => {
      e.preventDefault(); zone.classList.remove('drag-active');
      const file = e.dataTransfer?.files?.[0];
      if (!file || !file.type.startsWith('image/')) return;
      loadImageForCrop(i, file);
    });
  });
  // Card reorder drag
  attachCardDrag();
}

let dragCardIndex = null;

function attachCardDrag() {
  const rows = document.querySelectorAll('#card-list .card-row');
  rows.forEach(row => {
    const i = +row.dataset.cardIdx;
    const handle = row.querySelector('.card-drag-handle');

    // Only initiate drag from the handle so inputs/buttons still work normally
    handle.addEventListener('mousedown', () => { row.draggable = true; });
    handle.addEventListener('touchstart', () => { row.draggable = true; }, { passive: true });
    row.addEventListener('dragend', () => { row.draggable = false; });

    row.addEventListener('dragstart', e => {
      dragCardIndex = i;
      e.dataTransfer.effectAllowed = 'move';
      setTimeout(() => row.classList.add('dragging'), 0);
    });

    row.addEventListener('dragend', () => {
      row.classList.remove('dragging');
      document.querySelectorAll('#card-list .card-row').forEach(r => r.classList.remove('drag-over'));
      dragCardIndex = null;
    });

    row.addEventListener('dragover', e => {
      e.preventDefault();
      if (dragCardIndex === null || dragCardIndex === i) return;
      document.querySelectorAll('#card-list .card-row').forEach(r => r.classList.remove('drag-over'));
      row.classList.add('drag-over');
    });

    row.addEventListener('dragleave', () => row.classList.remove('drag-over'));

    row.addEventListener('drop', e => {
      e.preventDefault();
      row.classList.remove('drag-over');
      if (dragCardIndex === null || dragCardIndex === i) return;
      const from = dragCardIndex;
      const to = i;

      // Capture collapse state as a parallel boolean array before touching cards[]
      const wasCollapsed = cards.map((_, idx) => collapsedCards.has(idx));

      // Move the card data
      const moved = cards.splice(from, 1)[0];
      cards.splice(to, 0, moved);

      // Apply the same splice to the boolean array so collapse state follows each card
      const movedCollapse = wasCollapsed.splice(from, 1)[0];
      wasCollapsed.splice(to, 0, movedCollapse);

      // Rebuild the Set from the remapped array
      collapsedCards.clear();
      wasCollapsed.forEach((c, idx) => { if (c) collapsedCards.add(idx); });

      dragCardIndex = null;
      snapshot();
      renderCardList();
    });
  });
}

function handleDrop(i, event) {
  event.preventDefault();
  document.getElementById(`drop-${i}`)?.classList.remove('drag-active');
  const file = event.dataTransfer?.files?.[0];
  if (!file || !file.type.startsWith('image/')) return;
  loadImageForCrop(i, file);
}

// ============ CROP SYSTEM (pan + zoom, fixed square window) ============
let cropState = null;

function handleImg(i, input) {
  const file = input.files[0];
  if (!file) return;
  loadImageForCrop(i, file);
}

function loadImageForCrop(cardIndex, file) {
  const reader = new FileReader();
  reader.onload = e => {
    const img = new Image();
    img.onload = () => {
      // Always store the original full-resolution source
      cards[cardIndex].originalSrc = e.target.result;
      openCropWithSrc(cardIndex, e.target.result, img.naturalWidth, img.naturalHeight);
    };
    img.src = e.target.result;
  };
  reader.readAsDataURL(file);
}

function openCrop(cardIndex) {
  // Always open from the original source, not the previously cropped img
  const src = cards[cardIndex].originalSrc || cards[cardIndex].img;
  if (!src) return;
  const img = new Image();
  img.onload = () => openCropWithSrc(cardIndex, src, img.naturalWidth, img.naturalHeight);
  img.src = src;
}

function openCropWithSrc(cardIndex, src, nw, nh) {
  document.getElementById('crop-modal-root')?.remove();

  // Viewport matches card image aspect ratio (175×120) so crop is WYSIWYG
  const maxW = Math.min(400, window.innerWidth * 0.88);
  const vpW = maxW;
  const vpH = Math.round(vpW * (120 / 175)); // card image ratio

  const fitScale = Math.min(vpW / nw, vpH / nh);
  const initImgW = nw * fitScale;
  const initImgH = nh * fitScale;
  const initX = (vpW - initImgW) / 2;
  const initY = (vpH - initImgH) / 2;

  cropState = {
    cardIndex, src, nw, nh, vpW, vpH,
    scale: fitScale,
    fitScale,
    imgX: initX,
    imgY: initY,
  };

  const overlay = document.createElement('div');
  overlay.className = 'crop-modal-overlay';
  overlay.id = 'crop-modal-root';
  overlay.innerHTML = `
    <div class="crop-modal">
      <h3>✂ Crop image</h3>
      <p class="crop-hint">Drag to pan · scroll or slider to zoom · the square is your crop</p>
      <div class="crop-viewport" id="crop-vp" style="width:${vpW}px;height:${vpH}px;">
        <img class="crop-source-img" id="crop-img" src="${src}" draggable="false">
        <svg class="crop-grid" viewBox="0 0 ${vpW} ${vpH}" xmlns="http://www.w3.org/2000/svg">
          <line x1="${vpW/3}" y1="0" x2="${vpW/3}" y2="${vpH}"/>
          <line x1="${vpW*2/3}" y1="0" x2="${vpW*2/3}" y2="${vpH}"/>
          <line x1="0" y1="${vpH/3}" x2="${vpW}" y2="${vpH/3}"/>
          <line x1="0" y1="${vpH*2/3}" x2="${vpW}" y2="${vpH*2/3}"/>
        </svg>
        <div class="crop-frame"></div>
        <div class="crop-corner tl"></div>
        <div class="crop-corner tr"></div>
        <div class="crop-corner bl"></div>
        <div class="crop-corner br"></div>
      </div>
      <div class="crop-controls">
        <label>Zoom</label>
        <input type="range" id="crop-zoom" min="100" max="400" value="100"
          oninput="cropZoomSlider(+this.value)">
        <span class="crop-zoom-val" id="crop-zoom-label">100%</span>
      </div>
      <div class="crop-actions">
        <button class="crop-reset" id="crop-reset-btn">Reset view</button>
        <div style="display:flex;gap:8px;">
          <button class="btn" id="crop-use-original-btn" title="Remove crop and use full original image">↩ Original</button>
          <button class="btn" id="crop-cancel-btn">Cancel</button>
          <button class="btn btn-primary" id="crop-apply-btn">Apply crop</button>
        </div>
      </div>
    </div>
  `;
  document.body.appendChild(overlay);
  lockBodyScroll();
  overlay.addEventListener('click', e => { if (e.target === overlay) closeCrop(); });
  document.getElementById('crop-reset-btn').addEventListener('click', cropReset);
  document.getElementById('crop-cancel-btn').addEventListener('click', closeCrop);
  document.getElementById('crop-apply-btn').addEventListener('click', applyCrop);
  document.getElementById('crop-use-original-btn').addEventListener('click', useOriginal);
  applyCropTransform();
  attachCropDrag();
}

function applyCropTransform() {
  const { imgX, imgY, scale, nw, nh } = cropState;
  const img = document.getElementById('crop-img');
  if (!img) return;
  img.style.transform = `translate(${imgX}px, ${imgY}px) scale(${scale})`;
  img.style.width = nw + 'px';
  img.style.height = nh + 'px';
  // Update zoom slider to reflect actual zoom
  const pct = Math.round((scale / cropState.fitScale) * 100);
  const slider = document.getElementById('crop-zoom');
  if (slider) slider.value = pct;
  const label = document.getElementById('crop-zoom-label');
  if (label) label.textContent = pct + '%';
}

function clampPan() {
  const { nw, nh, scale, vpW, vpH } = cropState;
  const imgW = nw * scale;
  const imgH = nh * scale;
  cropState.imgX = Math.min(0, Math.max(vpW - imgW, cropState.imgX));
  cropState.imgY = Math.min(0, Math.max(vpH - imgH, cropState.imgY));
  if (imgW < vpW) cropState.imgX = (vpW - imgW) / 2;
  if (imgH < vpH) cropState.imgY = (vpH - imgH) / 2;
}

function cropZoomSlider(pct) {
  if (!cropState) return;
  const newScale = cropState.fitScale * (pct / 100);
  zoomCropTo(newScale);
}

function zoomCropTo(newScale, pivotX, pivotY) {
  const { vpW, vpH, nw, nh, scale, imgX, imgY } = cropState;
  const px = pivotX ?? vpW / 2;
  const py = pivotY ?? vpH / 2;
  const imgPxX = (px - imgX) / scale;
  const imgPxY = (py - imgY) / scale;
  const minScale = Math.max(vpW / nw, vpH / nh);
  const clampedScale = Math.max(minScale, newScale);
  cropState.scale = clampedScale;
  // Reposition so same image pixel stays under pivot
  cropState.imgX = px - imgPxX * clampedScale;
  cropState.imgY = py - imgPxY * clampedScale;
  clampPan();
  applyCropTransform();
}

function cropReset() {
  if (!cropState) return;
  const { vpW, vpH, nw, nh } = cropState;
  const minScale = Math.max(vpW / nw, vpH / nh);
  cropState.scale = minScale;
  cropState.imgX = (vpW - nw * minScale) / 2;
  cropState.imgY = (vpH - nh * minScale) / 2;
  clampPan();
  applyCropTransform();
}

function attachCropDrag() {
  const vp = document.getElementById('crop-vp');
  if (!vp) return;
  let drag = null;

  const startDrag = (cx, cy) => { drag = { sx: cx, sy: cy, ox: cropState.imgX, oy: cropState.imgY }; };
  const moveDrag = (cx, cy) => {
    if (!drag || !cropState) return;
    cropState.imgX = drag.ox + (cx - drag.sx);
    cropState.imgY = drag.oy + (cy - drag.sy);
    clampPan();
    applyCropTransform();
  };
  const endDrag = () => { drag = null; };

  cropState._mmove = e => moveDrag(e.clientX, e.clientY);
  cropState._mup   = endDrag;
  cropState._tmove = e => { if (drag) moveDrag(e.touches[0].clientX, e.touches[0].clientY); };
  cropState._tend  = endDrag;

  vp.addEventListener('mousedown', e => { startDrag(e.clientX, e.clientY); e.preventDefault(); });
  document.addEventListener('mousemove', cropState._mmove);
  document.addEventListener('mouseup',   cropState._mup);
  vp.addEventListener('touchstart', e => { startDrag(e.touches[0].clientX, e.touches[0].clientY); }, { passive: true });
  document.addEventListener('touchmove', cropState._tmove, { passive: true });
  document.addEventListener('touchend',  cropState._tend);

  // Pinch-to-zoom on touch
  let lastPinchDist = null;
  vp.addEventListener('touchstart', e => {
    if (e.touches.length === 2) {
      lastPinchDist = Math.hypot(
        e.touches[0].clientX - e.touches[1].clientX,
        e.touches[0].clientY - e.touches[1].clientY);
      drag = null;
    }
  }, { passive: true });
  vp.addEventListener('touchmove', e => {
    if (e.touches.length === 2 && lastPinchDist) {
      const dist = Math.hypot(
        e.touches[0].clientX - e.touches[1].clientX,
        e.touches[0].clientY - e.touches[1].clientY);
      const ratio = dist / lastPinchDist;
      const mx = (e.touches[0].clientX + e.touches[1].clientX) / 2;
      const my = (e.touches[0].clientY + e.touches[1].clientY) / 2;
      const rect = vp.getBoundingClientRect();
      zoomCropTo(cropState.scale * ratio, mx - rect.left, my - rect.top);
      lastPinchDist = dist;
    }
  }, { passive: true });
  vp.addEventListener('touchend', () => { lastPinchDist = null; });

  // Scroll wheel zoom
  vp.addEventListener('wheel', e => {
    e.preventDefault();
    const rect = vp.getBoundingClientRect();
    const px = e.clientX - rect.left;
    const py = e.clientY - rect.top;
    const factor = e.deltaY < 0 ? 1.1 : 0.9;
    zoomCropTo(cropState.scale * factor, px, py);
  }, { passive: false });
}

function applyCrop() {
  if (!cropState) return;
  const { src, nw, nh, scale, imgX, imgY, vpW, vpH, cardIndex } = cropState;
  const srcX = Math.max(0, Math.round(-imgX / scale));
  const srcY = Math.max(0, Math.round(-imgY / scale));
  const srcW = Math.min(Math.round(vpW / scale), nw - srcX);
  const srcH = Math.min(Math.round(vpH / scale), nh - srcY);

  const canvas = document.createElement('canvas');
  const outW = 350, outH = Math.round(350 / (vpW / vpH));
  canvas.width = outW; canvas.height = outH;
  const ctx = canvas.getContext('2d');
  const img = new Image();
  img.onload = () => {
    ctx.drawImage(img, srcX, srcY, srcW, srcH, 0, 0, outW, outH);
    // Store cropped version as display image, but keep original untouched
    cards[cardIndex].img = canvas.toDataURL('image/jpeg', 0.93);
    // originalSrc already set when image was first loaded — don't overwrite it
    closeCrop();
    snapshot();
    renderCardList();
  };
  img.src = src; // src is always originalSrc (set in openCropWithSrc)
}

function useOriginal() {
  // Revert card.img to the full original source (no crop)
  if (!cropState) return;
  const { cardIndex, src } = cropState;
  cards[cardIndex].img = src; // src is always originalSrc
  closeCrop();
  snapshot();
  renderCardList();
}

function lockBodyScroll() {
  const y = window.scrollY || window.pageYOffset || 0;
  document.body.dataset.scrollLockY = String(y);
  document.body.style.position = 'fixed';
  document.body.style.top = `-${y}px`;
  document.body.style.left = '0';
  document.body.style.right = '0';
  document.body.style.width = '100%';
}
function unlockBodyScroll() {
  const y = parseInt(document.body.dataset.scrollLockY || '0', 10);
  document.body.style.position = '';
  document.body.style.top = '';
  document.body.style.left = '';
  document.body.style.right = '';
  document.body.style.width = '';
  delete document.body.dataset.scrollLockY;
  window.scrollTo(0, y);
}

function closeCrop() {
  document.getElementById('crop-modal-root')?.remove();
  if (cropState) {
    document.removeEventListener('mousemove', cropState._mmove);
    document.removeEventListener('mouseup',   cropState._mup);
    document.removeEventListener('touchmove', cropState._tmove);
    document.removeEventListener('touchend',  cropState._tend);
  }
  cropState = null;
  unlockBodyScroll();
}
function buildTrumpCard(card) {
  const deckName = document.getElementById('deck-name').value || 'Top Trumps';
  const maxStat = 100;

  const statsHtml = cats.map(cat => {
    const val = card.stats[cat] ?? '';
    const range = catRanges[cat] || [0, 100];
    const span = range[1] - range[0] || 1;
    const barPct = showBars && val !== '' && val !== 'na' ? Math.min(100, Math.max(0, Math.round(((+val - range[0]) / span) * 100))) : 0;
    return `
      <div class="card-stat">
        <span class="stat-name">${escHtml(cat)}</span>
        ${showBars ? `<div class="stat-bar-wrap"><div class="stat-bar-fill" style="width:${barPct}%;background:${accentColor}"></div></div>` : ''}
        ${val === 'na'
          ? `<span class="stat-val is-na" style="color:${accentColor}">N/A</span>`
          : `<span class="stat-val" style="color:${accentColor}">${escHtml(String(val !== '' && val !== undefined ? val : '–'))}</span>`
        }
      </div>
    `;
  }).join('');

  // Build background style — gradient themes use bgColor as base hue
  function hexToRgb(hex) {
    const r = parseInt(hex.slice(1,3),16), g = parseInt(hex.slice(3,5),16), b = parseInt(hex.slice(5,7),16);
    return [r,g,b];
  }
  function darken(hex, amt) {
    const [r,g,b] = hexToRgb(hex);
    const d = (c) => Math.max(0, Math.round(c * (1 - amt)));
    return '#' + [d(r),d(g),d(b)].map(v=>v.toString(16).padStart(2,'0')).join('');
  }
  let bgStyle;
  if (themeStyle === 'holo') {
    const d1 = darken(bgColor, 0.15), d2 = darken(bgColor, 0.35);
    bgStyle = `background:linear-gradient(135deg,${bgColor},${d1},${d2})`;
  } else if (themeStyle === 'midnight') {
    const dark = darken(bgColor, 0.4);
    bgStyle = `background:linear-gradient(175deg,${bgColor} 0%,${dark} 100%)`;
  } else if (themeStyle === 'lockwood') {
    const dark = darken(bgColor, 0.35);
    bgStyle = `background:linear-gradient(175deg,${bgColor} 0%,${dark} 100%)`;
  } else {
    bgStyle = `background:${bgColor}`;
  }

  // Text colour on the name banner — light themes (paper) need dark text
  const [br,bg2,bb] = hexToRgb(bgColor);
  const luminance = (0.299*br + 0.587*bg2 + 0.114*bb) / 255;
  const nameBannerColor = luminance > 0.55 ? 'rgba(0,0,0,0.85)' : '#fff';

  const fileStripHtml = card.file ? `<div class="card-file-strip">
        <span class="card-file-label">Top Trumps File</span>${escHtml(card.file)}
      </div>` : '';

  return `
    <div class="trump-card theme-${themeStyle} frame-${frameStyle} border-${borderStyle}${showBars ? ' show-bars' : ''}${card.file ? ' has-file' : ''}"
      style="${bgStyle}">
      <div class="card-name-banner" style="color:${nameBannerColor};position:relative;">
        ${escHtml(card.name || 'Unnamed')}
        ${card.incomplete ? '<span class="card-incomplete-badge" title="Work in progress">⚠️</span>' : ''}
      </div>
      <div class="card-image">
        ${card.img ? `<img src="${card.img}" alt="${escHtml(card.name)}">` : '★'}
        ${card.topTrump ? '<canvas class="tt-stamp-canvas" width="76" height="76"></canvas>' : ''}
      </div>
      ${filePos === 'top' ? fileStripHtml : ''}
      <div class="card-stats-list">
        ${statsHtml}
      </div>
      ${filePos === 'bottom' ? fileStripHtml : ''}
      <div class="card-footer-bar">
        <span class="card-deck-label">${escHtml(deckName)}</span>
        ${!isPremium ? '<span style="font-size:6px;opacity:0.35;margin-left:auto;letter-spacing:0.04em;">toptrumpsmaker.com</span>' : ''}
      </div>
    </div>
  `;
}

// ============ STAMP CANVAS DRAWING ============
function drawStampOnCanvas(canvas) {
  if (!canvas) return;
  const size = canvas.width; // 76px
  const ctx = canvas.getContext('2d');
  const cx = size / 2, cy = size / 2, r = size / 2 - 1;

  // Gold outer ring
  ctx.beginPath(); ctx.arc(cx, cy, r, 0, Math.PI*2);
  ctx.fillStyle = '#e8b800'; ctx.fill();
  ctx.strokeStyle = '#b38600'; ctx.lineWidth = size*0.03; ctx.stroke();

  // Inner ring
  ctx.beginPath(); ctx.arc(cx, cy, r * 0.84, 0, Math.PI*2);
  ctx.strokeStyle = '#b38600'; ctx.lineWidth = size*0.025; ctx.stroke();

  // Black centre
  ctx.beginPath(); ctx.arc(cx, cy, r * 0.8, 0, Math.PI*2);
  ctx.fillStyle = '#1a1a1a'; ctx.fill();

  // Arc text helper — draws word along a circular arc
  // For top arc (startAngle > endAngle going clockwise over top): chars placed L→R, rotated upright facing out
  // For bottom arc: reverse char array so they read L→R, rotate upright facing out
  function drawArcText(word, arcR, startAngle, endAngle, fontSize, reverseChars) {
    let chars = word.split('');
    if (reverseChars) chars = chars.slice().reverse();
    const n = chars.length;
    chars.forEach((ch, i) => {
      const t = n === 1 ? 0.5 : i / (n - 1);
      const angle = startAngle + t * (endAngle - startAngle);
      const rad = angle * Math.PI / 180;
      const x = cx + Math.cos(rad) * arcR;
      const y = cy + Math.sin(rad) * arcR;
      ctx.save();
      ctx.translate(x, y);
      // Always rotate so char top faces away from centre (outward)
      ctx.rotate(rad + Math.PI / 2);
      ctx.font = '900 ' + fontSize + 'px "Arial Black", Arial, sans-serif';
      ctx.fillStyle = '#e8b800';
      ctx.textAlign = 'center';
      ctx.textBaseline = 'middle';
      ctx.fillText(ch, 0, 0);
      ctx.restore();
    });
  }

  const arcR = r * 0.56;
  const fontSize = size * 0.165;
  // TOP: 210°→330° across the top. No reversal needed — L index = leftmost char
  drawArcText('TOP',   arcR, 210, 330, fontSize, false);
  // TRUMP: 150°→30° across the bottom (going clockwise = decreasing angle).
  // Reverse chars so first char lands at 150° (left side) and last at 30° (right side),
  // reading left-to-right around the bottom.
  drawArcText('TRUMP', arcR, 150, 30, fontSize * 0.82, true);

  // Star
  ctx.font = size * 0.28 + 'px Arial';
  ctx.fillStyle = '#e8b800';
  ctx.textAlign = 'center';
  ctx.textBaseline = 'middle';
  ctx.fillText('★', cx, cy);
}

function drawAllStamps(root) {
  (root || document).querySelectorAll('.tt-stamp-canvas').forEach(drawStampOnCanvas);
}

// ============ PREVIEW / PRINT ============
function refresh() {
  if (previewing) previewDeck();
}

function previewDeck() {
  previewing = true;
  const area = document.getElementById('print-preview');
  area.innerHTML = cards.map(buildTrumpCard).join('');
  area.style.display = 'grid';
  document.querySelector('.cards-area').style.display = 'none';

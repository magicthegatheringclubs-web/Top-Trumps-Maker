      snapshot();
      renderCardList();
    }
  );
}


function getMedianForCard(cat, excludeIndex) {
  // Only uses OTHER cards so we don't bias toward the card being randomized
  const range = catRanges[cat] || [0, 100];
  const vals = cards
    .filter((_, j) => j !== excludeIndex)
    .map(c => c.stats[cat])
    .filter(v => v !== undefined && v !== '' && v !== 'na' && !isNaN(+v))
    .map(Number)
    .sort((a, b) => a - b);
  if (!vals.length) return Math.round((range[0] + range[1]) / 2);
  const mid = Math.floor(vals.length / 2);
  return vals.length % 2 === 0 ? Math.round((vals[mid-1] + vals[mid]) / 2) : vals[mid];
}

function randomizeCard(i) {
  const manual = cards[i].manualStats || new Set();
  cats.forEach(cat => {
    if (cards[i].stats[cat] === 'na') return;  // keep explicit N/A
    if (manual.has(cat)) return;                // skip manually entered stats
    const range = catRanges[cat] || [0, 100];
    const span = range[1] - range[0];
    const median = getMedianForCard(cat, i);
    const spread = Math.max(1, Math.round(span * 0.25));
    const raw = median + Math.round((Math.random() * 2 - 1) * spread);
    cards[i].stats[cat] = Math.min(range[1], Math.max(range[0], raw));
  });
  snapshot();
  renderCardList();
  if (previewing) previewDeck();
}

function clearCardStats(i) {
  const name = cards[i].name || 'this card';
  showConfirm(
    `Clear all stats for "${name}"?`,
    'All stat values and manual locks will be erased. You can undo with Ctrl+Z.',
    'Clear stats',
    () => {
      cats.forEach(cat => { cards[i].stats[cat] = ''; });
      cards[i].manualStats = new Set();

function loadProgress(input) {
  const file = input.files[0]; if (!file) return;
  const reader = new FileReader();
  reader.onload = e => {
    try {
      const s = JSON.parse(e.target.result);

      // Validate loosely — only require cards array
      if (!s || !Array.isArray(s.cards)) {
        alert("Couldn't load: not a valid Top Trumps save file.");
        return;
      }

      // ── Theme / display state (all optional for older saves) ──
      bgColor     = s.bgColor || s.deckColor || '#1a3a6b';
      accentColor = s.accentColor || '#ffffff';
      frameStyle  = s.frameStyle  || 'classic';
      borderStyle = s.borderStyle || 'none';
      themeStyle  = s.themeStyle  || 'classic';
      showBars    = s.showBars    || false;
      filePos     = s.filePos     || 'top';

      // ── Categories — infer from cards if missing ──
      if (Array.isArray(s.cats) && s.cats.length) {
        cats = s.cats;
      } else {
        const firstStats = s.cards[0]?.stats || {};
        cats = Object.keys(firstStats).filter(k => k !== 'na');
        if (!cats.length) cats = ['Speed', 'Power', 'Rarity'];
      }

      // ── Category ranges (optional) ──
      catRanges = s.catRanges || {};
      cats.forEach(c => { if (!catRanges[c]) catRanges[c] = [0, 100]; });

      // ── Cards: normalise each card to current schema ──
      cards = s.cards.map(c => ({
        name:       c.name      || 'Unnamed',
        img:        c.img       || null,
        originalSrc: c.originalSrc || c.img || null,
        file:       c.file      || '',
        topTrump:   c.topTrump  || false,
        stats:      c.stats     || {},
        manualStats: new Set(Array.isArray(c.manualStats) ? c.manualStats : []),
      }));

      // ── Deck name ──
      document.getElementById('deck-name').value = s.deckName || s.name || 'My Top Trumps';

      // ── Sync UI controls ──
      document.getElementById('custom-bg-color').value = bgColor;
      document.getElementById('custom-accent-color').value = accentColor;
      document.querySelectorAll('.theme-option').forEach(o => o.classList.toggle('active', o.dataset.theme === themeStyle));
      document.querySelectorAll('#frame-options .style-option').forEach(o => o.classList.toggle('active', o.dataset.frame === frameStyle));
      document.querySelectorAll('#border-options .style-option').forEach(o => o.classList.toggle('active', o.dataset.border === borderStyle));
      document.getElementById('bars-off-btn').classList.toggle('active', !showBars);
      document.getElementById('bars-on-btn').classList.toggle('active',  showBars);
      document.getElementById('file-top-btn').classList.toggle('active',    filePos === 'top');
      document.getElementById('file-bottom-btn').classList.toggle('active', filePos === 'bottom');

      snapshot();
      renderCats();
      renderCardList();
      renderColorSwatches();
      if (previewing) previewDeck();

    } catch (err) {
      console.error('Load error:', err);
      alert("Couldn't load that file. Make sure it's a Top Trumps save (.json).");
    } finally {
      input.value = '';
    }
  };
  reader.readAsText(file);
}


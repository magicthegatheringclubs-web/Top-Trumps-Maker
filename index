// ============ SPOTLIGHT CAROUSEL ============
let spotlightIndex = 0;

function openSpotlight(index) {
  spotlightIndex = index;
  document.getElementById('spotlight-root')?.remove();

  const overlay = document.createElement('div');
  overlay.className = 'spotlight-overlay';
  overlay.id = 'spotlight-root';
  overlay.innerHTML = `
    <button class="spotlight-close" id="sl-close" aria-label="Close">✕</button>
    <div class="spotlight-inner">
      <button class="spotlight-arrow" id="sl-prev" aria-label="Previous">◀</button>
      <div class="spotlight-card-wrap" id="sl-card-wrap"></div>
      <button class="spotlight-arrow" id="sl-next" aria-label="Next">▶</button>
    </div>
    <div class="spotlight-counter" id="sl-counter"></div>
  `;
  document.body.appendChild(overlay);

  overlay.addEventListener('click', e => { if (e.target === overlay) closeSpotlight(); });
  document.getElementById('sl-close').addEventListener('click', closeSpotlight);
  document.getElementById('sl-prev').addEventListener('click', () => moveSpotlight(-1));
  document.getElementById('sl-next').addEventListener('click', () => moveSpotlight(1));

  renderSpotlightCard();

  // Keyboard nav
  overlay._keyHandler = e => {
    if (e.key === 'ArrowLeft'  || e.key === 'ArrowUp')   { e.preventDefault(); moveSpotlight(-1); }
    if (e.key === 'ArrowRight' || e.key === 'ArrowDown')  { e.preventDefault(); moveSpotlight(1); }
    if (e.key === 'Escape') closeSpotlight();
  };
  document.addEventListener('keydown', overlay._keyHandler);

  // Swipe support
  let touchStartX = 0;
  overlay.addEventListener('touchstart', e => { touchStartX = e.touches[0].clientX; }, { passive: true });
  overlay.addEventListener('touchend', e => {
    const dx = e.changedTouches[0].clientX - touchStartX;
    if (Math.abs(dx) > 50) moveSpotlight(dx < 0 ? 1 : -1);
  });
}

function renderSpotlightCard() {
  const wrap = document.getElementById('sl-card-wrap');
  const counter = document.getElementById('sl-counter');
  const prev = document.getElementById('sl-prev');
  const next = document.getElementById('sl-next');
  if (!wrap) return;
  wrap.innerHTML = buildTrumpCard(cards[spotlightIndex]);
  drawAllStamps(wrap);
  counter.textContent = `${spotlightIndex + 1} / ${cards.length}`;
  prev.disabled = spotlightIndex === 0;
  next.disabled = spotlightIndex === cards.length - 1;
}

function moveSpotlight(dir) {
  const next = spotlightIndex + dir;
  if (next < 0 || next >= cards.length) return;
  spotlightIndex = next;
  renderSpotlightCard();
}

function closeSpotlight() {
  const overlay = document.getElementById('spotlight-root');
  if (!overlay) return;
  document.removeEventListener('keydown', overlay._keyHandler);
  overlay.remove();
}


function renderCardList() {
  document.getElementById('card-count-label').textContent = `Cards (${cards.length})`;
  if (typeof updateCardLimitUI === 'function') updateCardLimitUI();
  updateCollapseAllBtn();
  const list = document.getElementById('card-list');

  // Find which card index currently has focus — we'll skip re-rendering it
  // to prevent stealing focus mid-edit and causing the collapse-on-click bug.
  const focusedInput = document.activeElement;
  const focusedRow = focusedInput && focusedInput.closest?.('.card-row[data-card-idx]');
  const focusedCardIdx = focusedRow ? +focusedRow.dataset.cardIdx : -1;

  // If a card is being actively edited, update only the other rows
  // by rebuilding everything EXCEPT the focused card's row.
  // Simpler approach: if any card row has focus, skip the full re-render entirely
  // and just update the data-bound values surgically.
  if (focusedCardIdx >= 0 && !collapsedCards.has(focusedCardIdx)) {
    // Selectively refresh non-focused rows and the label only
    const existingRows = list.querySelectorAll('.card-row[data-card-idx]');
    existingRows.forEach(row => {
      const idx = +row.dataset.cardIdx;
      if (idx === focusedCardIdx) return; // skip the actively edited card
      const newHtml = buildOneCardRow(cards[idx], idx, collapsedCards.has(idx));
      const tmp = document.createElement('div');
      tmp.innerHTML = newHtml.trim();
      const newRow = tmp.firstElementChild;
      if (newRow) list.replaceChild(newRow, row);
    });
    attachCardListeners(list);
    return;
  }

  list.innerHTML = cards.map((card, i) => buildOneCardRow(card, i, collapsedCards.has(i))).join('');
  attachCardListeners(list);
}

